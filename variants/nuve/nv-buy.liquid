{%- doc -%}
  The second ask: the same product, lower down, with a button that adds it to
  the cart rather than one that scrolls.

  By this point on the page the argument has been made once, so this block is
  short on purpose: the photograph, what it is, what it costs, one button, and
  a link out to the full page for anyone who wants the detail.
{%- enddoc -%}

{%- liquid
  assign p = section.settings.product
  assign body = section.settings.text | default: p.metafields.custom.solution_line.value
-%}

{%- if p != blank -%}
  <section class="wf-section">
    <div class="pl-wrap nv-buy">
      {%- if p.featured_image != blank -%}
        <div class="nv-buy__media">
          <img
            src="{{ p.featured_image | image_url: width: 900 }}"
            srcset="{{ p.featured_image | image_url: width: 560 }} 560w, {{ p.featured_image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 760px) 92vw, 620px"
            width="{{ p.featured_image.width }}"
            height="{{ p.featured_image.height }}"
            alt="{{ p.featured_image.alt | default: p.title | escape }}"
            loading="lazy"
            decoding="async"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="nv-buy__title">{{ section.settings.heading | default: p.title }}</h2>
      {%- if body != blank -%}<p class="nv-buy__text">{{ body }}</p>{%- endif -%}
      <p class="nv-buy__price">{{ p.price | money }}</p>

      {%- form 'product', p -%}
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        <button type="submit" class="nv-cta" {% unless p.available %}disabled{% endunless %}>
          {%- if p.available -%}{{ section.settings.atc_label }}{%- else -%}אזל מהמלאי{%- endif -%}
        </button>
      {%- endform -%}

      {%- if section.settings.under != blank -%}
        <p class="nv-under">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.4 12.2l2.5 2.5 4.7-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{{ section.settings.under }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <div><a class="nv-more" href="{{ p.url }}">
          <span>{{ section.settings.link_label }}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a></div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "נובה · קנייה",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "המוצר" },
    { "type": "text", "id": "eyebrow", "label": "שורה מעל הכותרת" },
    { "type": "text", "id": "heading", "label": "כותרת (ריק לוקח את שם המוצר)" },
    { "type": "textarea", "id": "text", "label": "טקסט (ריק לוקח את הפתרון מהמוצר)" },
    { "type": "text", "id": "atc_label", "label": "כפתור", "default": "הוספה לסל" },
    { "type": "text", "id": "under", "label": "שורה מתחת לכפתור" },
    { "type": "text", "id": "link_label", "label": "קישור לעמוד המוצר", "default": "לפרטים המלאים" }
  ],
  "presets": [{ "name": "נובה · קנייה" }]
}
{% endschema %}
