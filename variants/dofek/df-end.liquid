{%- doc -%}
  The end of a product page: what else to look at, then the last ask.

  Two bands out of one section, and the reason is a limit rather than a
  design idea. A JSON template cannot cross the Admin API past about 16KB
  and the knee template is already at the ceiling, so a band that has to
  appear on all five product pages cannot be added as a sixth section to
  each of them. It is added here, to the one section every product page
  already ends with.

  The first band is the cross sell. Until now a product page ended at the
  buy button and nothing else in the shop was ever mentioned on it: five
  products that obviously belong together, and not one of them linked from
  another. The cards come off `all-products`, the current product drops out
  on its own, and the card itself is the same `wf-card` the home page and
  the collection use, so nothing here can drift away from them.

  The second band is the last ask: a photograph, a sentence and the button,
  on black. The price comes off the product rather than out of a setting,
  so it cannot go stale: change the price in the admin and this band
  changes with it.

  The button scrolls back to the buy box rather than linking to the product
  page, because on this template the buy box is already on the page and a
  link that reloads the page the visitor is standing on is a lost sale.
{%- enddoc -%}

{%- liquid
  assign p = section.settings.product | default: product
  assign classes = 'dl dl--dark'

  comment
    The collection is resolved over a chain rather than named once, because
    `all-products` is a collection somebody made by hand and `collections.all`
    is the one Shopify maintains itself. If the hand made one is ever renamed
    or emptied the row falls through to the automatic one instead of
    disappearing, which is the failure nobody would notice. The count is
    carried in its own variable so every step compares a number: a missing
    collection has no `products_count` at all, and comparing that to a number
    is the kind of thing that behaves differently in two Liquid engines.
  endcomment
  assign coll = collections[section.settings.also_collection]
  assign also_count = coll.products_count | default: 0
  if also_count < 2
    assign coll = collections['all-products']
    assign also_count = coll.products_count | default: 0
  endif
  if also_count < 2
    assign coll = collections.all
    assign also_count = coll.products_count | default: 0
  endif

  assign also_heading = section.settings.also_heading | default: 'הולך טוב עם זה'
  assign also = false
  if section.settings.show_also != false and also_heading != blank
    if also_count > 1
      assign also = true
    endif
  endif
-%}

{%- if also -%}
  {%- assign shown = 0 -%}
  {%- assign limit = section.settings.also_limit | default: 4 -%}
  {%- if limit < 2 -%}{%- assign limit = 4 -%}{%- endif -%}
  <section class="wf-section">
    <div class="pl-wrap">
      <h2 class="wf-h2">{{ also_heading }}</h2>
      {%- if section.settings.also_text != blank -%}
        <p class="wf-sub">{{ section.settings.also_text }}</p>
      {%- endif -%}

      {%- comment -%}
        Counted rather than limited, for the same reason wf-grid counts: a
        `limit` on the loop counts the products it walked past and not the
        cards it drew, so the row comes up one card short whenever the
        current product sorts early.
      {%- endcomment -%}
      <ul class="wf-grid" role="list">
        {%- for item in coll.products -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- unless item.handle == p.handle -%}
            <li>{% render 'wf-card', product: item %}</li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{%- if p != blank -%}
  <section class="{{ classes }}">
    <div class="pl-wrap">
      <div class="dl-end">
        <figure class="dl-end__media">
          {%- assign img = section.settings.image | default: p.featured_image -%}
          {%- if img != blank -%}
            <img
              src="{{ img | image_url: width: 900 }}"
              srcset="{{ img | image_url: width: 520 }} 520w, {{ img | image_url: width: 900 }} 900w"
              sizes="(min-width: 860px) 46vw, 100vw"
              width="{{ img.width }}"
              height="{{ img.height }}"
              alt="{{ section.settings.alt | default: p.title | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </figure>

        <div>
          {%- if section.settings.kicker != blank -%}
            <p class="dl__kicker">{{ section.settings.kicker }}</p>
          {%- endif -%}
          <h2 class="dl__h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}
            <p class="dl__sub">{{ section.settings.text }}</p>
          {%- endif -%}

          <p class="dl-end__price">{{ p.price | money }}</p>

          {%- liquid
            assign href = section.settings.link
            if href == blank
              if template.name == 'product' and p.id == product.id
                assign href = '#dp-buy'
              else
                assign href = p.url
              endif
            endif
          -%}
          <a class="wf-btn" href="{{ href }}">{{ section.settings.cta_label }}</a>

          {%- if section.settings.note != blank -%}
            <p class="dl__sub" style="margin-top:16px">{{ section.settings.note }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "DOFEK · סיום הדף",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "הולך עם זה" },
    { "type": "checkbox", "id": "show_also", "label": "להציג שורת מוצרים משלימים", "default": true },
    { "type": "text", "id": "also_heading", "label": "כותרת", "default": "הולך טוב עם זה" },
    { "type": "textarea", "id": "also_text", "label": "טקסט" },
    { "type": "collection", "id": "also_collection", "label": "קולקציה, ריק לוקח את כל המוצרים" },
    { "type": "range", "id": "also_limit", "label": "כמה כרטיסים", "min": 2, "max": 8, "step": 1, "default": 4 },

    { "type": "header", "content": "הקריאה האחרונה" },
    { "type": "product", "id": "product", "label": "מוצר, ריק לוקח את המוצר של הדף" },
    { "type": "image_picker", "id": "image", "label": "תמונה, ריק לוקח את תמונת המוצר" },
    { "type": "text", "id": "alt", "label": "תיאור התמונה לקוראי מסך" },
    { "type": "text", "id": "kicker", "label": "שורת פתיחה" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "זה הזמן לזוז עם יותר ביטחון" },
    { "type": "textarea", "id": "text", "label": "טקסט" },
    { "type": "text", "id": "cta_label", "label": "כפתור", "default": "רוכשים עכשיו" },
    { "type": "url", "id": "link", "label": "קישור, ריק גולל חזרה לקנייה" },
    { "type": "text", "id": "note", "label": "שורה תחתונה" }
  ],
  "presets": [{ "name": "DOFEK · סיום הדף" }]
}
{% endschema %}
