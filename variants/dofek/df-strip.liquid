{%- doc -%}
  Three facts on a black band, directly under the hero.

  Blocks rather than nine flat settings, so the merchant can drop one to two
  or add a fourth without the section rewriting itself around a gap.
{%- enddoc -%}

<section class="df-strip">
  <div class="pl-wrap">
    <div class="df-strip__in">
      {%- for block in section.blocks -%}
        <div class="df-strip__item" {{ block.shopify_attributes }}>
          <p class="df-strip__title">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}
            <p class="df-strip__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOFEK · פס עובדות",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "fact",
      "name": "עובדה",
      "settings": [
        { "type": "text", "id": "title", "label": "כותרת", "default": "משלוחים לכל הארץ" },
        { "type": "textarea", "id": "text", "label": "טקסט" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOFEK · פס עובדות",
      "blocks": [{ "type": "fact" }, { "type": "fact" }, { "type": "fact" }]
    }
  ]
}
{% endschema %}
