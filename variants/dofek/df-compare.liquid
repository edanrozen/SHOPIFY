{%- doc -%}
  DOFEK beside a plain knee sleeve.

  A real table at every width. The usual mobile trick, turning each row into
  its own stacked card, throws away the one thing a comparison exists for:
  reading two values on one line. A wide label column and two narrow mark
  columns keep that at 360px.

  Every row compares something that can be checked by looking at the two
  products. No row claims an outcome, a measurement or a study.
{%- enddoc -%}

{%- liquid
  assign classes = 'dl'
  case section.settings.ground
    when 'tint'
      assign classes = classes | append: ' dl--tint'
    when 'dark'
      assign classes = classes | append: ' dl--dark'
  endcase
-%}

{%- if section.blocks.size > 0 -%}
  <section class="{{ classes }}">
    <div class="pl-wrap">
      <div class="dl__head{% if section.settings.centred %} dl__head--mid{% endif %}">
        {%- if section.settings.kicker != blank -%}
          <p class="dl__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        <h2 class="dl__h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="dl__sub">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <table class="dl-cmp">
        <thead>
          <tr>
            <th class="dl-cmp__lbl" scope="col"><span class="visually-hidden">תכונה</span></th>
            <th class="dl-cmp__us" scope="col">{{ section.settings.us }}</th>
            <th class="dl-cmp__them" scope="col">{{ section.settings.them }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th class="dl-cmp__lbl" scope="row">{{ block.settings.label }}</th>
              <td class="dl-cmp__us">
                {%- if block.settings.us -%}
                  <span class="dl-mark dl-mark--y"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5"/></svg><span class="visually-hidden">יש</span></span>
                {%- else -%}
                  <span class="dl-mark dl-mark--n"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg><span class="visually-hidden">אין</span></span>
                {%- endif -%}
              </td>
              <td class="dl-cmp__them">
                {%- if block.settings.them -%}
                  <span class="dl-mark dl-mark--y"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5"/></svg><span class="visually-hidden">יש</span></span>
                {%- else -%}
                  <span class="dl-mark dl-mark--n"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg><span class="visually-hidden">אין</span></span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "DOFEK · טבלת השוואה",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "kicker", "label": "שורת פתיחה" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מה ההבדל" },
    { "type": "textarea", "id": "text", "label": "טקסט" },
    { "type": "checkbox", "id": "centred", "label": "כותרת במרכז", "default": true },
    { "type": "text", "id": "us", "label": "העמודה שלנו", "default": "DOFEK" },
    { "type": "text", "id": "them", "label": "העמודה השנייה", "default": "מגן ברך רגיל" },
    {
      "type": "select",
      "id": "ground",
      "label": "רקע",
      "default": "white",
      "options": [
        { "value": "white", "label": "לבן" },
        { "value": "tint", "label": "אפור בהיר" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "שורה",
      "settings": [
        { "type": "text", "id": "label", "label": "תכונה" },
        { "type": "checkbox", "id": "us", "label": "קיים ב־DOFEK", "default": true },
        { "type": "checkbox", "id": "them", "label": "קיים במגן רגיל", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "DOFEK · טבלת השוואה" }]
}
{% endschema %}
