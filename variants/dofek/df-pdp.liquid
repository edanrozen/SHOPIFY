{%- doc -%}
  DOFEK, the buying block.

  The gallery, the pickers, the quantity and the button, in one form.

  Two things here are deliberate and worth keeping.

  The form posts a plain <select name="id"> listing every variant. That
  select is the truth: it is what the browser submits, it works with
  JavaScript switched off, and df-pdp.js hides it and drives it from the
  swatches rather than replacing it. No hidden field has to be kept in step
  and nothing computes a variant id at submit time.

  The gallery renders every frame into the page rather than swapping one
  `src`. The browser has decoded the next photograph before the thumbnail is
  pressed, and with no JavaScript the first frame is simply the picture.
{%- enddoc -%}

{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign on_sale = false
  if p.compare_at_price > p.price
    assign on_sale = true
    assign off_pct = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | floor
  endif
  assign gallery = p.media | where: 'media_type', 'image'
-%}

<section class="dp wf-section--tight" id="dp-buy">
  <div class="pl-wrap">
    <div class="dp__in">

      {%- comment -%} ---- gallery ---- {%- endcomment -%}
      <figure class="dp__gal">
        <div class="dp__stage" data-dp-stage>
          {%- for m in gallery -%}
            <div class="dp__frame"{% if forloop.first %} data-on{% endif %}>
              <img
                src="{{ m | image_url: width: 1100 }}"
                srcset="{{ m | image_url: width: 560 }} 560w, {{ m | image_url: width: 860 }} 860w, {{ m | image_url: width: 1100 }} 1100w"
                sizes="(min-width: 900px) 48vw, 100vw"
                width="{{ m.preview_image.width }}"
                height="{{ m.preview_image.height }}"
                alt="{{ m.preview_image.alt | default: p.title | escape }}"
                data-full="{{ m | image_url: width: 1800 }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                decoding="async"
              >
            </div>
          {%- else -%}
            <div class="dp__frame" data-on>{{ 'product-1' | placeholder_svg_tag: 'dp__ph' }}</div>
          {%- endfor -%}
          {%- if gallery.size > 0 -%}
            <span class="dp__zoom" aria-hidden="true">⤢</span>
          {%- endif -%}
        </div>

        {%- if gallery.size > 1 -%}
          <div class="dp__thumbs" role="group" aria-label="תמונות המוצר">
            {%- for m in gallery -%}
              <button type="button" class="dp__thumb" data-dp-thumb="{{ forloop.index0 }}"
                      aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                      aria-label="תמונה {{ forloop.index }} מתוך {{ gallery.size }}">
                <img src="{{ m | image_url: width: 200 }}" width="78" height="78" alt="" loading="lazy" decoding="async">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </figure>

      {%- comment -%} ---- buy box ---- {%- endcomment -%}
      <div class="dp__buy">
        {%- if section.settings.kicker != blank -%}
          <p class="dp__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}

        <h1 class="dp__title">{{ section.settings.heading | default: p.title }}</h1>

        {%- if section.settings.lede != blank -%}
          <p class="dp__lede">{{ section.settings.lede }}</p>
        {%- endif -%}

        {%- assign bullets = section.settings.bullets | split: '|' -%}
        {%- if bullets.size > 0 -%}
          <ul class="dp__bullets">
            {%- for b in bullets -%}
              {%- assign bt = b | strip -%}
              {%- if bt != blank -%}<li>{{ bt }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <p class="dp__price">
          <span data-dp-price>{{ p.price | money }}</span>
          {%- if on_sale -%}
            <s class="dp__was">{{ p.compare_at_price | money }}</s>
            {%- if off_pct > 0 -%}<span class="dp__off">{{ off_pct }}%-</span>{%- endif -%}
          {%- endif -%}
        </p>
        {%- if section.settings.ship_note != blank -%}
          <p class="dp__ship">{{ section.settings.ship_note }}</p>
        {%- endif -%}

        {%- form 'product', p, id: 'dp-form', novalidate: 'novalidate' -%}
          <script type="application/json" data-dp-variants>
            [{% for var in p.variants %}{"id":{{ var.id }},"a":{{ var.available }},"o":{{ var.options | json }},"p":{{ var.price | money | json }},"t":{{ var.title | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
          </script>

          {%- comment -%}
            Without JavaScript this is the picker. With it, df-pdp.js hides
            this block, unhides the swatches, and keeps the select in step.
          {%- endcomment -%}
          <div class="dp__fallback" data-dp-fallback>
            <label for="dp-sel-{{ section.id }}">{{ section.settings.select_label }}</label>
            <select id="dp-sel-{{ section.id }}" name="id" data-dp-select>
              {%- for var in p.variants -%}
                <option value="{{ var.id }}" {% if var.id == v.id %}selected{% endif %} {% unless var.available %}disabled{% endunless %}>
                  {{ var.title }}{% unless var.available %} — אזל{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>

          <div class="dp__pickers" data-dp-pickers hidden>
            {%- for opt in p.options_with_values -%}
              {%- assign is_colour = false -%}
              {%- if opt.name contains 'צבע' or opt.name contains 'Color' or opt.name contains 'Colour' -%}
                {%- assign is_colour = true -%}
              {%- endif -%}
              <fieldset class="dp__opt" data-dp-opt="{{ forloop.index }}">
                <legend class="dp__legend">
                  <span>{{ opt.name }}</span>
                  {%- if is_colour == false and section.settings.size_help != blank -%}
                    <b><a href="#dp-faq">{{ section.settings.size_help }}</a></b>
                  {%- endif -%}
                </legend>
                <div class="dp__row">
                  {%- for val in opt.values -%}
                    {%- assign vname = val.name | default: val -%}
                    <label>
                      <input type="radio" name="dp-opt-{{ opt.position }}" value="{{ vname | escape }}"
                             data-dp-pos="{{ opt.position }}"
                             {% if opt.selected_value == vname %}checked{% endif %}>
                      {%- if is_colour -%}
                        {%- liquid
                          assign swatch = '#D6D6D6'
                          if vname contains 'שחור'
                            assign swatch = '#0A0A0A'
                          elsif vname contains 'לבן'
                            assign swatch = '#FFFFFF'
                          elsif vname contains 'אפור'
                            assign swatch = '#8A8A8A'
                          endif
                        -%}
                        <span class="dp__col">
                          <span class="dp__dot" style="background: {{ swatch }}"></span>
                          <span>{{ vname }}</span>
                        </span>
                      {%- else -%}
                        <span class="dp__size">{{ vname }}</span>
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>

          <div class="dp__buyrow">
            <div class="dp__qty">
              <button type="button" data-dp-qty="-1" aria-label="להפחית כמות">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="כמות" data-dp-qtyin>
              <button type="button" data-dp-qty="1" aria-label="להוסיף כמות">+</button>
            </div>
            <button type="submit" class="wf-btn dp__atc" data-dp-atc {% unless p.available %}disabled{% endunless %}>
              {%- if p.available -%}{{ section.settings.atc_label }}{%- else -%}אזל מהמלאי{%- endif -%}
            </button>
          </div>

          <p class="dp__done" data-dp-done aria-live="polite">
            <span>המוצר נוסף לסל.</span>
            <a href="{{ routes.cart_url }}">לסל הקניות</a>
          </p>
        {%- endform -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="dp__perks">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- case block.settings.icon -%}
                  {%- when 'return' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
                  {%- when 'ship' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h11v9H2z"/><path d="M13 10h4l4 3v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
                  {%- when 'chat' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 4H4v12h4v4l5-4h7z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 7.6-8 9-4.5-1.4-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- endcase -%}
                <span><b>{{ block.settings.title }}</b>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if p.available -%}
  <div class="dp-bar" data-dp-bar aria-hidden="true">
    <span class="dp-bar__t">
      <span class="dp-bar__p" data-dp-barprice>{{ p.price | money }}</span>
      <span class="dp-bar__v" data-dp-barvariant>{{ v.title }}</span>
    </span>
    <button type="submit" form="dp-form" class="wf-btn" tabindex="-1">{{ section.settings.atc_label }}</button>
  </div>
  <div class="dp-bar-spacer" aria-hidden="true"></div>
{%- endif -%}

<script src="{{ 'df-pdp.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "DOFEK · קנייה",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "שורת פתיחה", "default": "מוצר הדגל" },
    { "type": "text", "id": "heading", "label": "כותרת, ריק לוקח את שם המוצר" },
    { "type": "textarea", "id": "lede", "label": "תיאור קצר" },
    { "type": "textarea", "id": "bullets", "label": "יתרונות, מופרדים בקו אנכי" },
    { "type": "text", "id": "ship_note", "label": "שורה מתחת למחיר" },
    { "type": "text", "id": "select_label", "label": "תווית הבחירה", "default": "בחירת דגם" },
    { "type": "text", "id": "size_help", "label": "קישור עזרה במידה", "default": "לא בטוחים במידה?" },
    { "type": "text", "id": "atc_label", "label": "כפתור הוספה לסל", "default": "הוספה לסל" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "שורת ביטחון",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "אייקון",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "מגן" },
            { "value": "return", "label": "החזרה" },
            { "value": "ship", "label": "משלוח" },
            { "value": "chat", "label": "שירות" }
          ]
        },
        { "type": "text", "id": "title", "label": "כותרת" },
        { "type": "text", "id": "text", "label": "טקסט" }
      ]
    }
  ],
  "presets": [{ "name": "DOFEK · קנייה" }]
}
{% endschema %}
