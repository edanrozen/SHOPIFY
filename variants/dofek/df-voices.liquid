{%- doc -%}
  Where the reviews go.

  The shop has no orders, so it has no reviews, and this section invents
  none. What it does is put the container the review app writes into on the
  page and, until that container has something in it, say plainly that
  there are no reviews yet.

  Three sources, in order of trust:

    1. The review app's own container. Loox is installed on this shop and
       fills `#looxReviews` by product id. If another app replaces it, the
       container id is a setting.
    2. `product.metafields.reviews.rating`, which is the standard Shopify
       field every review app writes. It is read, never written, and it is
       the only place a star count on this page can come from.
    3. Nothing. Which is the honest state today, and is what shows.

  The note hides itself the moment the app puts a review in the container,
  so nobody has to remember to come back and switch it off.
{%- enddoc -%}

{%- liquid
  assign classes = 'dl'
  if section.settings.ground == 'tint'
    assign classes = classes | append: ' dl--tint'
  endif
  assign rating = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count
-%}

<section class="{{ classes }}" id="{{ section.settings.anchor | default: 'dp-reviews' }}">
  <div class="pl-wrap">
    <div class="dl__head dl__head--mid">
      {%- if section.settings.kicker != blank -%}
        <p class="dl__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2 class="dl__h2">{{ section.settings.heading }}</h2>

      {%- if rating != blank and count != blank and count > 0 -%}
        <p class="dl__sub">
          {{ rating.rating }} מתוך {{ rating.scale_max }}, לפי {{ count }} חוות דעת.
        </p>
      {%- elsif section.settings.text != blank -%}
        <p class="dl__sub">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div id="{{ section.settings.container | default: 'looxReviews' }}"
         data-product-id="{{ product.id }}"
         data-df-voices></div>

    {%- if section.settings.empty_text != blank -%}
      <p class="dl-empty" data-df-empty>{{ section.settings.empty_text }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var box = document.querySelector('[data-df-voices]');
    var note = document.querySelector('[data-df-empty]');
    if (!box || !note) return;
    var check = function () {
      if (box.children.length || box.textContent.trim()) {
        note.hidden = true;
        return true;
      }
      return false;
    };
    if (check()) return;
    if (!('MutationObserver' in window)) return;
    var mo = new MutationObserver(function () { if (check()) mo.disconnect(); });
    mo.observe(box, { childList: true, subtree: true });
    /* The app has either written by now or it is not installed. Either way
       the page stops watching rather than holding an observer open. */
    setTimeout(function () { mo.disconnect(); }, 15000);
  })();
</script>

{% schema %}
{
  "name": "DOFEK · חוות דעת",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "שורת פתיחה" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מה אומרים עלינו" },
    { "type": "textarea", "id": "text", "label": "טקסט" },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "טקסט כשאין עדיין ביקורות",
      "default": "החנות חדשה ועדיין אין כאן חוות דעת. לא נכתוב ביקורות שלא נכתבו, אז עד שיגיעו הביקורות הראשונות האזור הזה יישאר ריק. אם קניתם, נשמח לשמוע."
    },
    { "type": "text", "id": "container", "label": "מזהה המכולה של אפליקציית הביקורות", "default": "looxReviews" },
    { "type": "text", "id": "anchor", "label": "מזהה לעוגן", "default": "dp-reviews" },
    {
      "type": "select",
      "id": "ground",
      "label": "רקע",
      "default": "tint",
      "options": [
        { "value": "white", "label": "לבן" },
        { "value": "tint", "label": "אפור בהיר" }
      ]
    }
  ],
  "presets": [{ "name": "DOFEK · חוות דעת" }]
}
{% endschema %}
