{%- doc -%}
  The catalogue, after the visitor has been given a direction.

  It comes after the intents and after Bloom on purpose. A grid is what you
  show someone who already knows roughly what they want; leading with it asks
  them to do the sorting themselves.
{%- enddoc -%}

{%- liquid
  assign coll = collections[section.settings.collection]
  if coll == blank
    assign coll = collections.all
  endif

  comment
    Two handles are skipped: the one the merchant picked, and whatever product
    the page is already showing. The second matters because this same section
    is the "goes well with" row on a product page, and a row that recommends
    the item you are looking at spends a slot saying nothing.

    `product` is only bound on a product template, so on the homepage it is
    nil, its handle is blank, and no real handle ever equals blank.
  endcomment
  assign skip_picked = section.settings.exclude.handle
  assign skip_current = product.handle
-%}

<section class="wf-section">
  <div class="pl-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="wf-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="wf-sub">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- comment -%}
      Counted rather than limited, because a `limit` on the loop counts the
      products it walked past and not the cards it drew. With the skipped item
      inside the window that renders one card short, so an eight-up row quietly
      became seven whenever the excluded product happened to sort early.
    {%- endcomment -%}
    {%- assign shown = 0 -%}
    <ul class="wf-grid" role="list">
      {%- for item in coll.products -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- unless item.handle == skip_picked or item.handle == skip_current -%}
          <li>{% render 'wf-card', product: item %}</li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if shown == 0 -%}
        <li>{{ section.settings.empty_text }}</li>
      {%- endif -%}
    </ul>

    {%- if section.settings.more_label != blank -%}
      <div class="wf-more">
        <a class="wf-btn" href="{{ section.settings.more_link | default: routes.all_products_collection_url }}">
          {{ section.settings.more_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "תמות · רשת מוצרים",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "כל הכלים" },
    { "type": "textarea", "id": "text", "label": "טקסט" },
    { "type": "collection", "id": "collection", "label": "אוסף" },
    { "type": "product", "id": "exclude", "label": "מוצר שלא יופיע" },
    { "type": "range", "id": "limit", "label": "כמה מוצרים", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "empty_text", "label": "טקסט לרשימה ריקה", "default": "אין מוצרים להצגה." },
    { "type": "text", "id": "more_label", "label": "כפתור תחתון" },
    { "type": "url", "id": "more_link", "label": "קישור הכפתור" }
  ],
  "presets": [{ "name": "תמות · רשת מוצרים" }]
}
{% endschema %}
