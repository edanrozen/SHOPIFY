{%- doc -%}
  What did you come for?

  Chewy's "Shop by pet" row: a circle of photograph, the label under it, and
  nothing else. It is the most recognisable thing on their homepage, and it
  does the same job the tall photo cards did here in a fifth of the height.
  Nine products presented as nine products is a decision the visitor has to
  make; presented as three jobs it is a direction they can follow.

  The split is by job rather than by animal, because that is how this catalogue
  divides: grooming the coat, getting fur out of the house, and the two things
  made for cats alone.

  No product count under the label. It is real information, but on a nine
  product shop it only tells the visitor how little there is.

  A collection with no image of its own falls back to its first product's
  photograph, so a circle is never an empty ring.
{%- enddoc -%}

<section class="wf-section">
  <div class="pl-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="wf-h2" style="text-align: center;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="wf-sub" style="text-align: center; margin-inline: auto;">{{ section.settings.text }}</p>
    {%- endif -%}

    <ul class="wf-circles" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign card_img = coll.image
          if card_img == blank
            assign card_img = coll.products.first.featured_image
          endif
          assign card_title = block.settings.title | default: coll.title
        -%}
        {%- if coll != blank -%}
          <li {{ block.shopify_attributes }}>
            <a class="wf-circle" href="{{ coll.url }}">
              <span class="wf-circle__media">
                {%- if card_img != blank -%}
                  <img
                    src="{{ card_img | image_url: width: 400 }}"
                    srcset="{{ card_img | image_url: width: 220 }} 220w, {{ card_img | image_url: width: 400 }} 400w"
                    sizes="156px"
                    width="{{ card_img.width }}"
                    height="{{ card_img.height }}"
                    alt="{{ card_img.alt | default: card_title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
              </span>
              <p class="wf-circle__title">{{ card_title }}</p>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "תמות · למה הגעתם",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מה אתם מחפשים היום?" },
    { "type": "textarea", "id": "text", "label": "טקסט" }
  ],
  "blocks": [
    {
      "type": "intent",
      "name": "עיגול",
      "settings": [
        { "type": "collection", "id": "collection", "label": "אוסף" },
        { "type": "text", "id": "title", "label": "כותרת (ריק לוקח את שם האוסף)" },
        { "type": "text", "id": "text", "label": "טקסט (לא מוצג בעיצוב הזה)" },
        { "type": "text", "id": "link_label", "label": "קישור (לא מוצג בעיצוב הזה)" }
      ]
    }
  ],
  "presets": [{ "name": "תמות · למה הגעתם" }]
}
{% endschema %}
