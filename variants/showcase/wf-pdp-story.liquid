{%- doc -%}
  The problem, then the before and after, then what the product is.

  This is the top of the long product page and the only part that talks about
  the customer rather than about the product. Everything in it is read from the
  product's own metafields, so the page cannot say something the shop has not
  already committed to in the product record:

    custom.problem     the situation, in prose
    custom.before      a list of what it is like now
    custom.after       a list of what it is like with the product

  A product missing any one of these drops that piece rather than rendering an
  empty frame. A product missing all of them renders nothing at all, so the
  section can sit in the template for every product without being checked.

  custom.highlights used to render here too. It now sits above the buy box in
  wf-product, where it answers "what am I buying" before the price is reached,
  so it is deliberately absent from this band rather than forgotten.
{%- enddoc -%}

{%- liquid
  assign problem = product.metafields.custom.problem.value
  assign before = product.metafields.custom.before.value
  assign after = product.metafields.custom.after.value
  assign has_ba = false
  if before.size > 0 and after.size > 0
    assign has_ba = true
  endif
-%}

{%- if problem != blank or has_ba -%}
  <section class="wf-band wf-band--cream">
    <div class="pl-wrap">
      {%- if section.settings.heading != blank -%}
        <div class="wf-band__head">
          <h2 class="wf-h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}
            <p class="wf-sub">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if problem != blank -%}
        <div class="wf-prose">
          {{ problem | newline_to_br }}
        </div>
      {%- endif -%}

      {%- if has_ba -%}
        <div class="wf-ba" style="margin-top: clamp(24px, 4vw, 44px);">
          <div class="wf-ba__col wf-ba__col--before">
            <span class="wf-ba__tag wf-ba__tag--before">{{ section.settings.before_label }}</span>
            <ul class="wf-ba__list" role="list">
              {%- for line in before -%}<li>{{ line }}</li>{%- endfor -%}
            </ul>
          </div>
          <div class="wf-ba__col wf-ba__col--after">
            <span class="wf-ba__tag wf-ba__tag--after">{{ section.settings.after_label }}</span>
            <ul class="wf-ba__list" role="list">
              {%- for line in after -%}<li>{{ line }}</li>{%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "מוצר · הבעיה ולפני ואחרי",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "המצב היום, והמצב אחרי" },
    { "type": "textarea", "id": "text", "label": "טקסט מתחת לכותרת" },
    { "type": "text", "id": "before_label", "label": "תווית הצד הימני", "default": "לפני" },
    { "type": "text", "id": "after_label", "label": "תווית הצד השמאלי", "default": "אחרי" }
  ],
  "presets": [{ "name": "מוצר · הבעיה ולפני ואחרי" }]
}
{% endschema %}
