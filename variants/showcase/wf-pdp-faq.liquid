{%- doc -%}
  The specification table, what is in the box, the safety note, and the
  questions.

  custom.safety was written for all nine products and rendered nowhere. It is
  how to use the thing without hurting the animal, which on a grooming
  catalogue is not a footnote, so it sits with the specification rather than
  being folded into an FAQ answer nobody opens.

  The questions are real <details> elements rather than divs with a click
  handler, so every answer is in the document for a crawler and for a visitor
  whose JavaScript did not load. The open and close arrow is drawn in CSS from
  the element's own [open] state, so there is no script on this section at all.
{%- enddoc -%}

{%- liquid
  assign specs = product.metafields.custom.specs.value
  assign in_box = product.metafields.custom.in_box.value
  assign faq = product.metafields.custom.faq.value
  assign for_pets = product.metafields.custom.for_pets.value
  assign safety = product.metafields.custom.safety.value
  assign surfaces = product.metafields.custom.surfaces.value
  assign picker = product.metafields.custom.picker.value
-%}

{%- if specs.size > 0 or faq.size > 0 or in_box.size > 0 or safety != blank or picker.size > 0 -%}
  <section class="wf-band">
    <div class="pl-wrap">

      {%- comment -%}
        Which one of ours, before the specification of this one.

        custom.picker was written for six products and rendered nowhere. The
        catalogue has three fur removers and two combs, and a shopper who
        cannot tell which one is theirs does not buy the closest guess, they
        close the tab. This is the only content in the record that answers
        that, and it answers it in the shop's own words: the glove for corners
        and car seats, the 30cm head for sofas and carpets, the fine comb for
        knots, the double comb for the daily routine.

        The price comes from all_products rather than from the metafield, so a
        row can never quote a price the product no longer has. Lookups are
        capped at twenty per page by Liquid and no picker here holds more than
        four rows.
      {%- endcomment -%}
      {%- if picker.size > 0 -%}
        <div class="wf-band__head">
          <h2 class="wf-h2">{{ section.settings.picker_heading }}</h2>
        </div>
        <ul class="wf-pick" role="list">
          {%- for row in picker -%}
            {%- assign other = all_products[row.handle] -%}
            <li class="wf-pick__i{% if row.current %} wf-pick__i--now{% endif %}">
              <div class="wf-pick__head">
                <span class="wf-pick__n">{{ row.name }}</span>
                {%- if row.current -%}
                  <span class="wf-pick__now">{{ section.settings.picker_current }}</span>
                {%- elsif other != blank and other.price > 0 -%}
                  <span class="wf-pick__p">{{ other.price | money }}</span>
                {%- endif -%}
              </div>
              {%- if row.best_for != blank -%}
                <p class="wf-pick__b">{{ row.best_for }}</p>
              {%- endif -%}
              {%- if row.note != blank -%}
                <p class="wf-pick__x">{{ row.note }}</p>
              {%- endif -%}
              {%- unless row.current -%}
                {%- if other != blank -%}
                  <a class="wf-pick__a" href="{{ other.url }}">{{ section.settings.picker_cta }}</a>
                {%- endif -%}
              {%- endunless -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if specs.size > 0 or for_pets != blank -%}
        <div class="wf-band__head">
          <h2 class="wf-h2">{{ section.settings.specs_heading }}</h2>
        </div>
        <div class="wf-specs">
          {%- if for_pets != blank -%}
            <div class="wf-specs__row">
              <span class="wf-specs__k">{{ section.settings.for_label }}</span>
              <span class="wf-specs__v">{{ for_pets }}</span>
            </div>
          {%- endif -%}
          {%- for row in specs -%}
            <div class="wf-specs__row">
              <span class="wf-specs__k">{{ row.label }}</span>
              <span class="wf-specs__v">{{ row.value }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if surfaces.size > 0 -%}
        <ul class="wf-chips" role="list">
          {%- for line in surfaces -%}<li>{{ line }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if safety != blank -%}
        <div class="wf-aside">
          <p class="wf-aside__t">{{ section.settings.safety_label }}</p>
          <p class="wf-aside__x">{{ safety | newline_to_br }}</p>
        </div>
      {%- endif -%}

      {%- if in_box.size > 0 -%}
        <ul class="wf-chips" role="list">
          {%- for line in in_box -%}<li>{{ line }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if faq.size > 0 -%}
        <div class="wf-band__head" style="margin-top: clamp(32px, 5vw, 60px);">
          <h2 class="wf-h2">{{ section.settings.faq_heading }}</h2>
        </div>
        <div class="wf-faq">
          {%- for item in faq -%}
            <details class="wf-faq__item"{% if forloop.first %} open{% endif %}>
              <summary class="wf-faq__q">{{ item.q }}</summary>
              <p class="wf-faq__a">{{ item.a }}</p>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "מוצר · מפרט ושאלות",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "picker_heading", "label": "כותרת ההשוואה", "default": "איזה מהם מתאים לכם" },
    { "type": "text", "id": "picker_current", "label": "סימון המוצר הנוכחי", "default": "זה העמוד שאתם בו" },
    { "type": "text", "id": "picker_cta", "label": "קישור למוצר אחר", "default": "לעמוד המוצר" },
    { "type": "text", "id": "specs_heading", "label": "כותרת המפרט", "default": "המפרט" },
    { "type": "text", "id": "safety_label", "label": "כותרת פסקת הבטיחות", "default": "בטיחות ושימוש נכון" },
    { "type": "text", "id": "for_label", "label": "שם השורה של מתאים ל", "default": "מתאים ל" },
    { "type": "text", "id": "faq_heading", "label": "כותרת השאלות", "default": "שאלות שחוזרות" }
  ],
  "presets": [{ "name": "מוצר · מפרט ושאלות" }]
}
{% endschema %}
