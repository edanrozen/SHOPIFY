<section class="pl-cats pl-section">
  <div class="pl-wrap">
    <header class="pl-rowhead pl-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="pl-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}
      </div>
    </header>

    <ul class="pl-cats__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign img = block.settings.image | default: coll.image
          assign title = block.settings.title | default: coll.title
          assign url = coll.url | default: '/collections/all'
          assign feature = ''
          if block.settings.feature
            assign feature = ' pl-cat--feature'
          endif
        -%}
        <li class="pl-cat{{ feature }} pl-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 70 }}ms;">
          <a class="pl-cat__link" href="{{ url }}">
            <div class="pl-cat__media">
              {%- if img != blank -%}
                <img
                  src="{{ img | image_url: width: 1000 }}"
                  srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 1000 }} 1000w"
                  sizes="(max-width: 700px) 92vw, 46vw"
                  width="{{ img.width }}" height="{{ img.height }}"
                  alt="{{ img.alt | default: title | escape }}"
                  loading="lazy" decoding="async"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'pl-cat__ph' }}
              {%- endif -%}
            </div>
            <div class="pl-cat__body">
              <h3 class="pl-cat__title">{{ title }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="pl-cat__text">{{ block.settings.text }}</p>
              {%- endif -%}
              <span class="pl-cat__cta">
                {{ block.settings.cta | default: 'לצפייה' }}
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                  <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .pl-cats { background: var(--pl-porcelain); }
  .pl-cats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(14px, 1.8vw, 22px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 900px) { .pl-cats__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .pl-cat--feature { grid-column: span 2; grid-row: span 2; } }

  .pl-cat__link {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--pl-r-l);
    overflow: hidden;
    text-decoration: none;
    color: var(--pl-porcelain);
    background: var(--pl-sand);
    isolation: isolate;
  }
  .pl-cat__media { position: absolute; inset: 0; z-index: -2; }
  .pl-cat__media img, .pl-cat__ph {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 1.1s var(--pl-ease);
  }
  .pl-cat__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(20, 18, 15, .74) 0%, rgba(20, 18, 15, .28) 52%, rgba(20, 18, 15, .06) 100%);
  }
  .pl-cat__link:hover img { transform: scale(1.06); }

  .pl-cat__body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 210px;
    height: 100%;
    padding: clamp(18px, 2.2vw, 28px);
    gap: 6px;
  }
  .pl-cat--feature .pl-cat__body { min-height: 320px; }
  @media (min-width: 900px) { .pl-cat--feature .pl-cat__body { min-height: 440px; } }

  .pl-cat__title {
    font-family: var(--pl-serif);
    font-weight: 500;
    font-size: clamp(1.2rem, 2vw, 1.75rem);
    line-height: 1.2;
    margin: 0;
    color: #FFFFFF;
  }
  .pl-cat--feature .pl-cat__title { font-size: clamp(1.6rem, 3vw, 2.5rem); }
  .pl-cat__text {
    font-family: var(--pl-sans);
    font-size: .89rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, .84);
    margin: 0;
    max-width: 34ch;
  }
  .pl-cat__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--pl-sans);
    font-size: .86rem;
    font-weight: 600;
    color: #FFFFFF;
    margin-block-start: 8px;
  }
  [dir="rtl"] .pl-cat__cta svg { transform: scaleX(-1); }
  .pl-cat__link:hover .pl-cat__cta svg { transform: translateX(3px); }
  [dir="rtl"] .pl-cat__link:hover .pl-cat__cta svg { transform: scaleX(-1) translateX(3px); }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "מה מחפשים היום" },
    { "type": "textarea", "id": "body", "label": "Body" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "לצפייה" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "checkbox", "id": "feature", "label": "Large tile", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "PLUMA · Categories",
    "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }]
  }]
}
{% endschema %}
