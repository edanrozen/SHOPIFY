<section class="pl-cats pl-section">
  <div class="pl-wrap">
    <header class="pl-rowhead pl-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="pl-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}
      </div>
    </header>

    <ul class="pl-cats__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          comment
            Only two of the collections carry an image of their own. Rather than
            invent artwork for the others, a card falls back to the first
            product in the collection, which is a photograph that already
            exists and already shows what the category contains.
          endcomment
          assign img = block.settings.image | default: coll.image | default: coll.products.first.featured_image
          assign title = block.settings.title | default: coll.title
          assign url = coll.url | default: '/collections/all'
          assign feature = ''
          if block.settings.feature
            assign feature = ' pl-cat--feature'
          endif
        -%}
        <li class="pl-cat{{ feature }} pl-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 70 }}ms;">
          <a class="pl-cat__link" href="{{ url }}">
            <div class="pl-cat__media">
              {%- if img != blank -%}
                <img
                  src="{{ img | image_url: width: 1000 }}"
                  srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 1000 }} 1000w"
                  sizes="(max-width: 700px) 92vw, 46vw"
                  width="{{ img.width }}" height="{{ img.height }}"
                  alt="{{ img.alt | default: title | escape }}"
                  loading="lazy" decoding="async"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'pl-cat__ph' }}
              {%- endif -%}
            </div>
            <div class="pl-cat__body">
              <h3 class="pl-cat__title">{{ title }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="pl-cat__text">{{ block.settings.text }}</p>
              {%- endif -%}
              <span class="pl-cat__cta">
                {{ block.settings.cta | default: 'לצפייה' }}
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                  <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .pl-cats { background: var(--pl-porcelain); }
  .pl-cats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(14px, 1.8vw, 22px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 900px) { .pl-cats__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* With three categories a two-column phone grid leaves an orphan, so the
     first one takes the full width and the other two pair up under it. */
  .pl-cat--feature { grid-column: 1 / -1; }
  .pl-cat--feature .pl-cat__media { aspect-ratio: 16 / 10; }
  @media (min-width: 900px) {
    .pl-cat--feature { grid-column: auto; }
    .pl-cat--feature .pl-cat__media { aspect-ratio: 1 / 1; }
  }

  /* The card used to be a photograph with a dark gradient poured over it and
     white type on top. It read as heavy, it fought a white page, and the words
     were at the mercy of whatever the photograph happened to show underneath.
     Now the photograph is a frame and the words sit under it on the page's own
     ground, which is both quieter and legible with any image. */
  .pl-cat__link {
    display: grid;
    gap: 12px;
    height: 100%;
    text-decoration: none;
    color: var(--pl-ink);
    background: transparent;
  }
  .pl-cat__media {
    border-radius: var(--pl-r-m);
    overflow: hidden;
    background: var(--pl-cream);
    aspect-ratio: 1 / 1;
  }
  .pl-cat__media img, .pl-cat__ph {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 1.1s var(--pl-ease);
  }
  /* Gated: on touch, :hover sticks to the last thing tapped. */
  @media (hover: hover) and (pointer: fine) {
    .pl-cat__link:hover img { transform: scale(1.06); }
  }

  /* No minimum height any more: the words take the room they need and the
     photograph above them supplies the weight. */
  .pl-cat__body { display: grid; gap: 4px; padding: 0; }

  .pl-cat__title {
    font-family: var(--pl-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 3.6vw, 1.25rem);
    line-height: 1.25;
    margin: 0;
    color: var(--pl-ink);
  }
  .pl-cat--feature .pl-cat__title { font-size: clamp(1.2rem, 4.4vw, 1.5rem); }
  .pl-cat__text {
    font-family: var(--pl-sans);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--pl-taupe);
    margin: 0;
    max-width: 34ch;
  }
  .pl-cat__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--pl-sans);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--pl-ink);
    margin-block-start: 4px;
  }
  [dir="rtl"] .pl-cat__cta svg { transform: scaleX(-1); }
  /* Gated: on touch, :hover sticks to the last thing tapped. */
  @media (hover: hover) and (pointer: fine) {
    .pl-cat__link:hover .pl-cat__cta svg { transform: translateX(3px); }
    [dir="rtl"] .pl-cat__link:hover .pl-cat__cta svg { transform: scaleX(-1) translateX(3px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TinyBloom · Categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "מה מחפשים היום" },
    { "type": "textarea", "id": "body", "label": "Body" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "לצפייה" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "checkbox", "id": "feature", "label": "Large tile", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "TinyBloom · Categories",
    "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }]
  }]
}
{% endschema %}
