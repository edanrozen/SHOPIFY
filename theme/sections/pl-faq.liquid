<section class="pl-faq pl-section">
  <div class="pl-wrap pl-faq__grid">
    <div class="pl-faq__intro pl-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="pl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.contact_label != blank -%}
        <a class="pl-btn pl-btn--ghost pl-faq__contact" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_label }}</a>
      {%- endif -%}
    </div>

    <div class="pl-faq__list">
      {%- for block in section.blocks -%}
        <details class="pl-faq__item pl-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 60 }}ms;">
          <summary>
            <span>{{ block.settings.q }}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </summary>
          <div class="pl-faq__answer pl-body">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pl-faq { background: var(--pl-porcelain); }
  .pl-faq__grid { display: grid; gap: clamp(32px, 4.5vw, 72px); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 940px) { .pl-faq__grid { grid-template-columns: .82fr 1.18fr; } }
  .pl-faq__contact { margin-block-start: 26px; }
  .pl-faq__item { border-block-end: 1px solid var(--pl-line); }
  .pl-faq__item:first-child { border-block-start: 1px solid var(--pl-line); }
  .pl-faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-block: clamp(20px, 2.6vw, 26px);
    font-family: var(--pl-sans);
    font-size: 1.03rem;
    font-weight: 600;
    color: var(--pl-ink);
  }
  .pl-faq__item summary::-webkit-details-marker { display: none; }
  .pl-faq__item summary svg { flex: 0 0 auto; color: var(--pl-clay); transition: transform .35s var(--pl-ease); }
  .pl-faq__item[open] summary svg { transform: rotate(45deg); }
  .pl-faq__answer { padding-block-end: 26px; max-width: 60ch; font-size: .97rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "שאלות שחוזרות" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "כל מה ששואלים אותנו לפני שקונים" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "לא מצאתם תשובה? כתבו לנו ונחזור אליכם באותו יום עסקים." },
    { "type": "text", "id": "contact_label", "label": "Button", "default": "לדבר איתנו" },
    { "type": "url", "id": "contact_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "שאלה" },
        { "type": "textarea", "id": "a", "label": "Answer", "default": "תשובה" }
      ]
    }
  ],
  "presets": [{
    "name": "PLUMA · FAQ",
    "blocks": [
      { "type": "qa", "settings": { "q": "זה עובד גם על שיער חתולים קצר?", "a": "כן. גליל הנחושת נועד בדיוק לשיער קצר וקשיח שנתקע בסיבי הבד, הסוג שרולר דביק לא מצליח להוציא. לשיער ארוך מומלץ לשלב עם המסרק." } },
      { "type": "qa", "settings": { "q": "צריך למלא או להחליף משהו?", "a": "לא. אין מילויים, אין דבק ואין סוללות. מנערים את מגש האיסוף, שוטפים במים פושרים ומייבשים. זו הוצאה חד פעמית." } },
      { "type": "qa", "settings": { "q": "זה לא יפגע בבד של הספה?", "a": "לא בשימוש נכון. הגליל מכני ולא חד, עובדים בכיוון אחד ובלחץ קל. על בדים עדינים מאוד כמו משי או קטיפה דקה מומלץ לבדוק קודם בפינה נסתרת." } },
      { "type": "qa", "settings": { "q": "מה מדיניות ההחזרות?", "a": "30 יום להתנסות בבית. אם הכלי לא עשה את העבודה, מחזירים ומקבלים החזר מלא, גם אם כבר השתמשתם בו." } }
    ]
  }]
}
{% endschema %}
