{%- comment -%}
  The guarantee band. Everything here is a commitment the shop actually keeps,
  written plainly, because a promise a customer can check is what buys trust.
{%- endcomment -%}

<section class="pl-promise pl-section" style="--pl-promise-bg: {{ section.settings.background }}; --pl-promise-fg: {{ section.settings.text_color }};">
  <div class="pl-wrap">
    <header class="pl-promise__head pl-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pl-eyebrow pl-promise__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="pl-h2 pl-promise__h">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="pl-lede pl-promise__lede">{{ section.settings.body }}</p>
      {%- endif -%}
    </header>

    <ul class="pl-promise__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="pl-promise__item pl-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 70 }}ms;">
          <span class="pl-promise__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.2-2.9 7.7-7 9.5-4.1-1.8-7-5.3-7-9.5V6l7-3z"/><path d="M9 12.2l2 2 4-4.2"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h10v9H3z"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4h-4"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A2.5 2.5 0 0 1 17.5 17H9l-4 3.5V6.5A2.5 2.5 0 0 1 7.5 4h10A2.5 2.5 0 0 1 20 6.5z"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-7 4.5-12 14-12 0 8.5-5 12-10 12H5z"/><path d="M5 19c3-4 6-6 10-7.5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M8.6 12.2l2.3 2.3 4.5-4.7"/></svg>
            {%- endcase -%}
          </span>
          <span class="pl-promise__title">{{ block.settings.title }}</span>
          <span class="pl-promise__text">{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.note != blank -%}
      <p class="pl-promise__note pl-reveal">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pl-promise {
    background: var(--pl-promise-bg, #191713);
    color: var(--pl-promise-fg, #FBF9F5);
  }
  .pl-promise__head { max-width: 44rem; }
  .pl-promise__eyebrow { color: var(--pl-clay); }
  .pl-promise__h { color: inherit; }
  .pl-promise__lede { color: inherit; opacity: .74; }

  .pl-promise__grid {
    list-style: none;
    margin: clamp(28px, 4vw, 52px) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-block-start: 1px solid currentColor;
  }
  .pl-promise__item {
    display: grid;
    gap: 8px;
    padding-block: 22px;
    border-block-end: 1px solid currentColor;
  }
  /* The hairlines are the whole look, so they stay thin and low contrast. */
  .pl-promise__grid, .pl-promise__item { border-color: color-mix(in srgb, currentColor 18%, transparent); }
  @media (min-width: 760px) {
    .pl-promise__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(28px, 4vw, 60px); }
  }
  @media (min-width: 1080px) {
    .pl-promise__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .pl-promise__item { padding-block: 26px 0; border-block-end: 0; }
  }

  .pl-promise__icon { display: block; color: var(--pl-clay); }
  .pl-promise__icon svg { width: 26px; height: 26px; display: block; }
  .pl-promise__title {
    font-family: var(--pl-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
    margin-block-start: 4px;
  }
  .pl-promise__text {
    font-family: var(--pl-sans);
    font-size: .92rem;
    line-height: 1.7;
    opacity: .72;
  }
  .pl-promise__note {
    font-family: var(--pl-sans);
    font-size: .82rem;
    line-height: 1.7;
    opacity: .55;
    margin: clamp(22px, 3vw, 34px) 0 0;
    max-width: 46rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Promise",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ההתחייבות שלנו" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "קונים אצלנו בלי לקחת סיכון" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "textarea", "id": "note", "label": "Small print" },
    { "type": "color", "id": "background", "label": "Background", "default": "#191713" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FBF9F5" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "chat", "label": "Support" },
            { "value": "leaf", "label": "Materials" },
            { "value": "check", "label": "Check" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "כותרת" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "PLUMA · Promise" }]
}
{% endschema %}
