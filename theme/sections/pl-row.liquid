{%- liquid
  assign coll = collections[section.settings.collection]
  assign products = coll.products
  if coll == blank
    assign products = collections.all.products
  endif
  assign list_class = 'pl-grid pl-grid--4'
  if section.settings.layout == 'rail'
    assign list_class = 'pl-rail'
  elsif section.settings.columns == '3'
    assign list_class = 'pl-grid pl-grid--3'
  endif
-%}

<section class="pl-row pl-section" style="--pl-row-bg: {{ section.settings.background }};">
  <div class="pl-wrap">
    <header class="pl-rowhead pl-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="pl-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="pl-link" href="{{ section.settings.link_url | default: coll.url | default: '/collections/all' }}">
          {{ section.settings.link_label }}
        </a>
      {%- endif -%}
    </header>

    <ul class="{{ list_class }}" role="list">
      {%- for product in products limit: section.settings.limit -%}
        <li class="pl-reveal" style="transition-delay: {{ forloop.index0 | times: 60 }}ms;">
          {% render 'pl-card', product: product, cta: section.settings.card_cta %}
        </li>
      {%- else -%}
        <li class="pl-body">האוסף הזה עדיין ריק.</li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .pl-row { background: var(--pl-row-bg, var(--pl-porcelain)); }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Product row",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "rail", "label": "Horizontal scroll" }
      ]
    },
    { "type": "select", "id": "columns", "label": "Columns (grid)", "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "הקולקציה" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "לכל המוצרים" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "text", "id": "card_cta", "label": "Card hover text", "default": "לפרטים" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBF9F5" }
  ],
  "presets": [{ "name": "PLUMA · Product row" }]
}
{% endschema %}
