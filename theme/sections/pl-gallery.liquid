{%- doc -%}
  A band of photographs.

  Two modes, one section.

  Pick a product and the band renders that product's own media, in order,
  straight from the catalogue. Nothing is chosen by hand, nothing goes stale
  when a photograph is added or replaced, and every tile links to the product.
  This is the mode that matters: the flagship has eight photographs that a
  shopper currently only sees after committing to a click.

  Leave the product empty and it renders image blocks instead, for editorial
  photography that does not belong to any one product.

  On a phone it is a rail the thumb pushes, with its own scroll container, so
  the page itself never gains scrollable width. From the tablet up it is a
  plain grid.
{%- enddoc -%}

{%- liquid
  assign prod = section.settings.product
  assign use_product = false
  if prod != blank and prod.media.size > 0
    assign use_product = true
  endif
-%}

{%- if use_product or section.blocks.size > 0 -%}
  <section class="pl-gal pl-section" style="--pl-gal-bg: {{ section.settings.background }};">
    <div class="pl-wrap">
      <header class="pl-rowhead pl-reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="pl-h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          <a class="pl-link" href="{{ section.settings.link_url | default: prod.url | default: '/collections/all' }}">
            {{ section.settings.link_label }}
          </a>
        {%- endif -%}
      </header>

      <ul class="pl-gal__rail" role="list">
        {%- if use_product -%}
          {%- for media in prod.media -%}
            {%- assign im = media.preview_image -%}
            <li class="pl-gal__item">
              <a class="pl-gal__link" href="{{ prod.url }}">
                <img
                  src="{{ im | image_url: width: 900 }}"
                  srcset="{{ im | image_url: width: 450 }} 450w, {{ im | image_url: width: 900 }} 900w"
                  sizes="(max-width: 759px) 74vw, 30vw"
                  width="{{ im.width }}" height="{{ im.height }}"
                  alt="{{ im.alt | default: prod.title | escape }}"
                  loading="lazy" decoding="async"
                >
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- assign im = block.settings.image -%}
            <li class="pl-gal__item" {{ block.shopify_attributes }}>
              <div class="pl-gal__link">
                {%- if im != blank -%}
                  <img
                    src="{{ im | image_url: width: 900 }}"
                    srcset="{{ im | image_url: width: 450 }} 450w, {{ im | image_url: width: 900 }} 900w"
                    sizes="(max-width: 759px) 74vw, 30vw"
                    width="{{ im.width }}" height="{{ im.height }}"
                    alt="{{ im.alt | default: block.settings.caption | escape }}"
                    loading="lazy" decoding="async"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'pl-gal__ph' }}
                {%- endif -%}
              </div>
              {%- if block.settings.caption != blank -%}
                <p class="pl-gal__cap">{{ block.settings.caption }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if section.settings.hint != blank -%}
        <p class="pl-gal__hint">{{ section.settings.hint }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .pl-gal { background: var(--pl-gal-bg, var(--pl-porcelain)); }

  /* The rail bleeds into the gutter so the last tile is visibly cut off at the
     edge of the screen. That cut edge is the only honest affordance a
     horizontal list has on a phone: it tells the thumb there is more. */
  .pl-gal__rail {
    list-style: none;
    margin: 0;
    margin-inline: calc(var(--pl-gutter) * -1);
    padding: 0 var(--pl-gutter) 4px;
    display: flex;
    gap: clamp(10px, 1.6vw, 16px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pl-gal__rail::-webkit-scrollbar { display: none; }

  .pl-gal__item {
    flex: 0 0 74%;
    scroll-snap-align: start;
    min-width: 0;
  }
  .pl-gal__link {
    display: block;
    border-radius: var(--pl-r-m);
    overflow: hidden;
    background: var(--pl-cream);
    border: 1px solid var(--pl-line);
    aspect-ratio: 4 / 5;
  }
  .pl-gal__link img, .pl-gal__ph {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 1s var(--pl-ease);
  }
  /* Gated: on touch, :hover sticks to the last thing tapped. */
  @media (hover: hover) and (pointer: fine) {
    a.pl-gal__link:hover img { transform: scale(1.04); }
  }

  .pl-gal__cap {
    font-family: var(--pl-sans);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--pl-ink-soft);
    margin: 10px 0 0;
    max-width: 30ch;
  }
  .pl-gal__hint {
    font-family: var(--pl-sans);
    font-size: 12.5px;
    color: var(--pl-taupe);
    margin: 14px 0 0;
  }
  @media (min-width: 760px) { .pl-gal__hint { display: none; } }

  @media (min-width: 760px) {
    .pl-gal__rail {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(14px, 1.8vw, 20px);
      overflow: visible;
      margin-inline: 0;
      padding: 0;
    }
    .pl-gal__item { flex: initial; }
  }
  /* Eight tiles in a three column grid is three rows of desk height. A fourth
     column on a wide screen halves that without shrinking anything below the
     size at which a photograph is still worth looking at. */
  @media (min-width: 1100px) {
    .pl-gal__rail { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TinyBloom · Gallery",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "מוצר",
      "info": "אם בוחרים מוצר, הגלריה מציגה את התמונות שלו אוטומטית ומתעדכנת איתו. אם משאירים ריק, מציגים את התמונות שמוסיפים למטה."
    },
    { "type": "text", "id": "eyebrow", "label": "שורה עליונה" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מכל זווית" },
    { "type": "textarea", "id": "body", "label": "טקסט" },
    { "type": "text", "id": "hint", "label": "רמז לגלילה", "info": "מוצג בטלפון בלבד." },
    { "type": "text", "id": "link_label", "label": "קישור" },
    { "type": "url", "id": "link_url", "label": "כתובת הקישור" },
    { "type": "color", "id": "background", "label": "רקע", "default": "#FBF9F5" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "תמונה",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "תמונה" },
        { "type": "text", "id": "caption", "label": "כיתוב" }
      ]
    }
  ],
  "presets": [{ "name": "TinyBloom · Gallery" }]
}
{% endschema %}
