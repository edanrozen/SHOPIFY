{%- liquid
  comment
    Reviews arrive in two metafields so a long list can grow without rewriting
    the original one. The average and the total are derived from the merged
    items rather than stored alongside them, so the summary can never drift
    away from the reviews printed underneath it.
  endcomment
  assign items = product.metafields.custom.reviews.value.items
  assign extra = product.metafields.custom.reviews_more.value.items
  if items == blank
    assign items = extra
  elsif extra != blank
    assign items = items | concat: extra
  endif

  assign total = items.size
  assign sum = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  for r in items
    assign sum = sum | plus: r.rating
    case r.rating
      when 5
        assign c5 = c5 | plus: 1
      when 4
        assign c4 = c4 | plus: 1
      when 3
        assign c3 = c3 | plus: 1
      when 2
        assign c2 = c2 | plus: 1
      else
        assign c1 = c1 | plus: 1
    endcase
  endfor

  assign avg = 0
  if total > 0
    assign avg = sum | times: 1.0 | divided_by: total | round: 1
  endif

  assign shown = section.settings.initial | default: 6
  assign step = section.settings.step | default: 10
  assign remaining = total | minus: shown
-%}

{%- if items.size > 0 -%}
<section class="pl-rev pl-section" id="pl-reviews" style="scroll-margin-block-start: 96px;">
  <div class="pl-wrap">
    <header class="pl-rowhead pl-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="pl-h2">{{ section.settings.heading }}</h2>
      </div>
    </header>

    <div class="pl-rev__grid">
      <aside class="pl-rev__summary pl-reveal">
        <p class="pl-rev__avg">{{ avg }}</p>
        {% render 'pl-stars', value: avg, size: 20, label: 'דירוג ממוצע' %}
        <p class="pl-rev__count">מבוסס על {{ total }} ביקורות</p>

        <ul class="pl-rev__bars" role="list">
          {%- assign counts = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
          {%- for n in counts -%}
            {%- liquid
              assign stars = 5 | minus: forloop.index0
              assign num = n | times: 1
              assign pct = 0
              if items.size > 0
                assign pct = num | times: 100 | divided_by: items.size
              endif
            -%}
            <li>
              <span class="pl-rev__bar-label">{{ stars }}</span>
              <span class="pl-rev__bar"><span style="width: {{ pct }}%"></span></span>
              <span class="pl-rev__bar-num">{{ num }}</span>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.note != blank -%}
          <p class="pl-rev__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </aside>

      <div class="pl-rev__list" id="pl-rev-list-{{ section.id }}">
        {%- for r in items -%}
          <article class="pl-rev__item{% if forloop.index > shown %} is-hidden{% endif %}">
            <div class="pl-rev__top">
              {% render 'pl-stars', value: r.rating, size: 14, label: r.rating %}
              {%- if r.date != blank -%}<time class="pl-rev__date">{{ r.date | date: '%d.%m.%Y' }}</time>{%- endif -%}
            </div>
            {%- if r.title != blank -%}<h3 class="pl-rev__title">{{ r.title }}</h3>{%- endif -%}
            <p class="pl-rev__body">{{ r.body }}</p>
            <footer class="pl-rev__by">
              <span class="pl-rev__name">{{ r.name }}</span>
              {%- if r.meta != blank -%}<span class="pl-rev__meta">{{ r.meta }}</span>{%- endif -%}
              {%- if r.verified -%}<span class="pl-rev__ok">רכישה מאומתת</span>{%- endif -%}
            </footer>
          </article>
        {%- endfor -%}

        {%- if items.size > shown -%}
          <button
            type="button"
            class="pl-btn pl-btn--ghost pl-rev__more"
            data-pl-more="{{ section.id }}"
            data-pl-step="{{ step }}"
            data-pl-label="{{ section.settings.more_label | escape }}"
          >
            {{ section.settings.more_label }} ({{ remaining }})
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var btn = document.querySelector('[data-pl-more="{{ section.id }}"]');
    if (!btn) return;
    var list = document.getElementById('pl-rev-list-{{ section.id }}');
    var step = parseInt(btn.getAttribute('data-pl-step'), 10) || 10;
    var label = btn.getAttribute('data-pl-label');

    // A long list is revealed a page at a time. Dropping sixty cards into the
    // document at once costs a layout the phone can feel.
    btn.addEventListener('click', function () {
      var hidden = list.querySelectorAll('.pl-rev__item.is-hidden');
      for (var i = 0; i < step && i < hidden.length; i++) {
        hidden[i].classList.remove('is-hidden');
      }
      var left = list.querySelectorAll('.pl-rev__item.is-hidden').length;
      if (left === 0) {
        btn.remove();
      } else {
        btn.textContent = label + ' (' + left + ')';
      }
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .pl-rev { background: var(--pl-porcelain); }
  .pl-rev__grid { display: grid; gap: clamp(28px, 4vw, 56px); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 940px) { .pl-rev__grid { grid-template-columns: .72fr 1.28fr; } }

  .pl-rev__summary {
    background: var(--pl-cream);
    border-radius: var(--pl-r-l);
    padding: clamp(24px, 3vw, 34px);
    text-align: center;
    position: sticky;
    top: 96px;
  }
  @media (max-width: 939px) { .pl-rev__summary { position: static; } }
  .pl-rev__avg { font-family: var(--pl-display); font-weight: 700; font-size: 3.4rem; line-height: 1; color: var(--pl-ink); margin: 0 0 10px; }
  .pl-rev__count { font-family: var(--pl-sans); font-size: .85rem; color: var(--pl-taupe); margin: 12px 0 0; }
  .pl-rev__bars { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 7px; }
  .pl-rev__bars li { display: grid; grid-template-columns: 14px 1fr 24px; align-items: center; gap: 10px; }
  .pl-rev__bar-label, .pl-rev__bar-num { font-family: var(--pl-sans); font-size: .76rem; color: var(--pl-taupe); }
  .pl-rev__bar-num { text-align: end; }
  .pl-rev__bar { display: block; height: 6px; border-radius: 3px; background: var(--pl-sand-deep); overflow: hidden; }
  .pl-rev__bar > span { display: block; height: 100%; background: var(--pl-clay); border-radius: 3px; }
  .pl-rev__note { font-family: var(--pl-sans); font-size: .74rem; line-height: 1.55; color: var(--pl-taupe); margin: 20px 0 0; }

  .pl-rev__list { display: grid; gap: 16px; }
  .pl-rev__item {
    background: var(--pl-white);
    border: 1px solid var(--pl-line);
    border-radius: var(--pl-r-m);
    padding: clamp(20px, 2.4vw, 28px);
  }
  .pl-rev__item.is-hidden { display: none; }
  .pl-rev__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pl-rev__date { font-family: var(--pl-sans); font-size: .76rem; color: var(--pl-taupe); }
  .pl-rev__title { font-family: var(--pl-sans); font-size: 1rem; font-weight: 600; color: var(--pl-ink); margin: 12px 0 8px; }
  .pl-rev__body { font-family: var(--pl-sans); font-size: .95rem; line-height: 1.72; color: var(--pl-ink-soft); margin: 0; }
  .pl-rev__by { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-block-start: 16px; }
  .pl-rev__name { font-family: var(--pl-sans); font-size: .86rem; font-weight: 600; color: var(--pl-ink); }
  .pl-rev__meta { font-family: var(--pl-sans); font-size: .8rem; color: var(--pl-taupe); }
  .pl-rev__ok {
    font-family: var(--pl-sans);
    font-size: .72rem;
    color: var(--pl-moss);
    background: rgba(87, 100, 79, .1);
    padding: 3px 10px;
    border-radius: var(--pl-r-pill);
  }
  .pl-rev__more { justify-self: start; margin-block-start: 6px; }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Product reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "מה אומרים הלקוחות" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ביקורות על המוצר" },
    { "type": "range", "id": "initial", "label": "Reviews shown before expanding", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "step", "label": "Reviews revealed per click", "min": 5, "max": 30, "step": 5, "default": 10 },
    { "type": "text", "id": "more_label", "label": "Show more label", "default": "להצגת עוד ביקורות" },
    { "type": "textarea", "id": "note", "label": "Note under the summary", "default": "הביקורות מנוהלות דרך שדה מותאם במוצר. לפני ההשקה יש להחליף אותן בביקורות אמיתיות של לקוחות." }
  ],
  "presets": [{ "name": "PLUMA · Product reviews" }]
}
{% endschema %}
