{%- comment -%}
  A heading over its own background, then one wide image underneath.
  Used for the family shot of the range. Text and photo never overlap.
{%- endcomment -%}

{%- liquid
  assign img = section.settings.image
-%}

<section class="pl-banner pl-section" style="--pl-banner-bg: {{ section.settings.background }};">
  <div class="pl-wrap">
    <div class="pl-banner__head pl-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="pl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="pl-lede pl-banner__lede">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="pl-banner__media pl-reveal">
      {%- if img != blank -%}
        <img
          src="{{ img | image_url: width: 1400 }}"
          srcset="{{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1100 }} 1100w, {{ img | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 899px) 92vw, 1100px"
          width="{{ img.width }}"
          height="{{ img.height }}"
          alt="{{ img.alt | default: section.settings.image_alt | escape }}"
          loading="lazy" decoding="async"
        >
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'pl-banner__ph' }}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="pl-banner__actions pl-reveal">
        <a class="pl-btn pl-btn--solid" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pl-banner { background: var(--pl-banner-bg, var(--pl-cream)); }
  .pl-banner__head { text-align: center; max-width: 40rem; margin-inline: auto; }
  .pl-banner__lede { margin-inline: auto; }
  .pl-banner__media {
    margin-block-start: clamp(24px, 4vw, 44px);
    border-radius: var(--pl-r-l);
    overflow: hidden;
    background: var(--pl-porcelain);
    max-width: 1100px;
    margin-inline: auto;
  }
  .pl-banner__media img, .pl-banner__ph { width: 100%; height: auto; display: block; }
  .pl-banner__actions { display: flex; justify-content: center; margin-block-start: clamp(22px, 3vw, 34px); }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Image banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "הפתרונות שלנו לאהבה שלכם" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F5EFE6" }
  ],
  "presets": [{ "name": "PLUMA · Image banner" }]
}
{% endschema %}
