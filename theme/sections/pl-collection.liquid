<section class="pl-coll">
  <header class="pl-coll__hero">
    {%- if collection.image != blank -%}
      <div class="pl-coll__media">
        <img
          src="{{ collection.image | image_url: width: 1800 }}"
          srcset="{{ collection.image | image_url: width: 900 }} 900w, {{ collection.image | image_url: width: 1600 }} 1600w"
          sizes="100vw"
          width="{{ collection.image.width }}" height="{{ collection.image.height }}"
          alt="{{ collection.image.alt | default: collection.title | escape }}"
          fetchpriority="high" decoding="async"
        >
      </div>
    {%- endif -%}
    <div class="pl-wrap pl-coll__inner{% if collection.image == blank %} pl-coll__inner--plain{% endif %}">
      <nav class="pl-coll__crumbs" aria-label="ניווט">
        <a href="/">בית</a><span aria-hidden="true">/</span><span>{{ collection.title }}</span>
      </nav>
      <h1 class="pl-coll__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="pl-coll__desc">{{ collection.description }}</div>
      {%- endif -%}
      <p class="pl-coll__count">{{ collection.products_count }} מוצרים</p>
    </div>
  </header>

  <div class="pl-wrap pl-coll__body">
    <ul class="pl-grid pl-grid--4" role="list">
      {%- for item in collection.products -%}
        <li class="pl-reveal" style="transition-delay: {{ forloop.index0 | times: 50 }}ms;">
          {% render 'pl-card', product: item, price_placeholder: section.settings.price_placeholder %}
        </li>
      {%- else -%}
        <li class="pl-body">{{ section.settings.empty_text }}</li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <nav class="pl-coll__pager" aria-label="עמודים">
        {{ paginate | default_pagination }}
      </nav>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pl-coll { background: var(--pl-porcelain); }
  .pl-coll__hero { position: relative; isolation: isolate; overflow: hidden; }
  .pl-coll__media { position: absolute; inset: 0; z-index: -2; }
  .pl-coll__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pl-coll__hero::after {
    content: "";
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgba(20, 18, 15, .72) 0%, rgba(20, 18, 15, .34) 60%, rgba(20, 18, 15, .16) 100%);
  }
  .pl-coll__inner {
    padding-block: clamp(56px, 8vw, 120px) clamp(28px, 4vw, 46px);
    color: #FFFFFF;
  }
  .pl-coll__inner--plain { color: var(--pl-ink); padding-block: clamp(36px, 5vw, 64px) clamp(20px, 3vw, 32px); }
  .pl-coll__crumbs { display: flex; gap: 8px; font-family: var(--pl-sans); font-size: .8rem; opacity: .85; }
  .pl-coll__crumbs a { color: inherit; text-decoration: none; }
  .pl-coll__title {
    font-family: var(--pl-serif);
    font-weight: 500;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.1;
    margin: 14px 0 0;
  }
  .pl-coll__desc {
    font-family: var(--pl-sans);
    font-size: 1.02rem;
    line-height: 1.7;
    margin-block-start: 14px;
    max-width: 56ch;
    opacity: .92;
  }
  .pl-coll__desc p { margin: 0; }
  .pl-coll__count { font-family: var(--pl-sans); font-size: .82rem; margin: 18px 0 0; opacity: .8; }
  .pl-coll__body { padding-block: clamp(34px, 4.5vw, 60px) clamp(56px, 8vw, 100px); }
  .pl-coll__pager { margin-block-start: 44px; font-family: var(--pl-sans); font-size: .9rem; }
  .pl-coll__pager a { color: var(--pl-ink); }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "price_placeholder", "label": "Price placeholder", "default": "המחיר יעודכן בקרוב" },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "האוסף הזה עדיין ריק. חזרו בקרוב." }
  ]
}
{% endschema %}
