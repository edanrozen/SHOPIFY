<section class="pl-showcase pl-section">
  <div class="pl-wrap pl-showcase__grid">
    <div class="pl-showcase__copy pl-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="pl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}

      <ul class="pl-showcase__points">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="pl-showcase__point-title">{{ block.settings.title }}</span>
            <span class="pl-showcase__point-text">{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.cta_label != blank -%}
        <a class="pl-btn pl-btn--solid pl-showcase__cta" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>

    <div class="pl-showcase__media pl-reveal">
      {%- if section.settings.image_1 != blank -%}
        <figure class="pl-showcase__fig pl-showcase__fig--tall">
          <img
            src="{{ section.settings.image_1 | image_url: width: 900 }}"
            srcset="{{ section.settings.image_1 | image_url: width: 500 }} 500w, {{ section.settings.image_1 | image_url: width: 900 }} 900w"
            sizes="(max-width: 900px) 46vw, 26vw"
            width="{{ section.settings.image_1.width }}"
            height="{{ section.settings.image_1.height }}"
            alt="{{ section.settings.image_1.alt | escape }}"
            loading="lazy" decoding="async"
          >
        </figure>
      {%- endif -%}
      {%- if section.settings.image_2 != blank -%}
        <figure class="pl-showcase__fig pl-showcase__fig--short">
          <img
            src="{{ section.settings.image_2 | image_url: width: 900 }}"
            srcset="{{ section.settings.image_2 | image_url: width: 500 }} 500w, {{ section.settings.image_2 | image_url: width: 900 }} 900w"
            sizes="(max-width: 900px) 46vw, 26vw"
            width="{{ section.settings.image_2.width }}"
            height="{{ section.settings.image_2.height }}"
            alt="{{ section.settings.image_2.alt | escape }}"
            loading="lazy" decoding="async"
          >
        </figure>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pl-showcase { background: var(--pl-porcelain); }
  .pl-showcase__grid {
    display: grid;
    gap: clamp(32px, 5vw, 70px);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) { .pl-showcase__grid { grid-template-columns: 1fr 1fr; } }

  .pl-showcase__points {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .pl-showcase__points li {
    display: grid;
    gap: 4px;
    padding-inline-start: 22px;
    position: relative;
  }
  .pl-showcase__points li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: .55em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--pl-clay);
  }
  .pl-showcase__point-title {
    font-family: var(--pl-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--pl-ink);
  }
  .pl-showcase__point-text {
    font-family: var(--pl-sans);
    font-size: .93rem;
    line-height: 1.65;
    color: var(--pl-ink-soft);
  }
  .pl-showcase__cta { margin-block-start: 32px; }

  .pl-showcase__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 1.6vw, 20px);
    align-items: center;
  }
  .pl-showcase__fig { margin: 0; border-radius: var(--pl-r-l); overflow: hidden; background: var(--pl-cream); }
  .pl-showcase__fig img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pl-showcase__fig--tall  { aspect-ratio: 4 / 5; transform: translateY(-14px); }
  .pl-showcase__fig--short { aspect-ratio: 4 / 5; transform: translateY(14px); }
  @media (max-width: 560px) {
    .pl-showcase__fig--tall, .pl-showcase__fig--short { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Showcase",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "לכלבים ולחתולים כאחד" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{
    "name": "PLUMA · Showcase",
    "blocks": [{ "type": "point" }, { "type": "point" }]
  }]
}
{% endschema %}
