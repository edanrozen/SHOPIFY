{%- doc -%}
  The long form half of a product page.

  One section, shared by every product. Nothing here is written per template:
  each part reads a metafield off the product and renders only if that metafield
  has content, so a product with no `custom.safety` simply has no safety block
  and the page stays tight rather than showing an empty heading.

  Adding a product later means filling metafields, not editing Liquid.
{%- enddoc -%}

{%- liquid
  assign problem  = product.metafields.custom.problem.value
  assign before   = product.metafields.custom.before.value
  assign after    = product.metafields.custom.after.value
  assign steps    = product.metafields.custom.steps.value
  assign why      = product.metafields.custom.why.value
  assign audience = product.metafields.custom.audience.value
  assign safety   = product.metafields.custom.safety.value
  assign faq      = product.metafields.custom.faq.value
  assign for_pets = product.metafields.custom.for_pets.value

  comment
    Image slots for the before and after cards. Empty today by design: the
    merchant is shooting these separately. The cards lay out correctly with or
    without them, so dropping a file into the metafield later is the whole job.
  endcomment
  assign before_img = product.metafields.custom.before_image.value
  assign after_img  = product.metafields.custom.after_image.value
-%}

{%- if problem != blank or steps != blank or why != blank or faq != blank -%}
<section class="pl-story2 pl-section" id="pl-story-{{ section.id }}">
  <div class="pl-wrap">

    {%- if problem != blank -%}
      <div class="pl-story2__problem pl-reveal">
        <p class="pl-eyebrow">{{ section.settings.problem_eyebrow }}</p>
        <p class="pl-story2__problem-text">{{ problem }}</p>
      </div>
    {%- endif -%}

    {%- if before != blank and after != blank -%}
      <div class="pl-story2__part pl-reveal">
        <h2 class="pl-h2">{{ section.settings.compare_heading }}</h2>
        <div class="pl-cmp">
          <div class="pl-cmp__card pl-cmp__card--before">
            <span class="pl-cmp__tag">{{ section.settings.before_label }}</span>
            {%- if before_img != blank -%}
              <img class="pl-cmp__img" src="{{ before_img | image_url: width: 720 }}"
                   width="360" height="270" loading="lazy" decoding="async"
                   alt="{{ section.settings.before_label | escape }}">
            {%- endif -%}
            <ul class="pl-cmp__list" role="list">
              {%- for line in before -%}<li>{{ line }}</li>{%- endfor -%}
            </ul>
          </div>
          <div class="pl-cmp__card pl-cmp__card--after">
            <span class="pl-cmp__tag">{{ section.settings.after_label }}</span>
            {%- if after_img != blank -%}
              <img class="pl-cmp__img" src="{{ after_img | image_url: width: 720 }}"
                   width="360" height="270" loading="lazy" decoding="async"
                   alt="{{ section.settings.after_label | escape }}">
            {%- endif -%}
            <ul class="pl-cmp__list" role="list">
              {%- for line in after -%}<li>{{ line }}</li>{%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if steps != blank -%}
      <div class="pl-story2__part pl-reveal">
        <h2 class="pl-h2">{{ section.settings.steps_heading }}</h2>
        <ol class="pl-steps" role="list">
          {%- for step in steps -%}
            <li class="pl-steps__item">
              <span class="pl-steps__num" aria-hidden="true">{{ forloop.index }}</span>
              <h3 class="pl-steps__title">{{ step.title }}</h3>
              {%- if step.text != blank -%}<p class="pl-steps__text">{{ step.text }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- if why != blank -%}
      <div class="pl-story2__part pl-reveal">
        <h2 class="pl-h2">{{ section.settings.why_heading }}</h2>
        {%- if section.settings.why_body != blank -%}
          <p class="pl-lede">{{ section.settings.why_body }}</p>
        {%- endif -%}
        <ul class="pl-why" role="list">
          {%- for item in why -%}
            <li class="pl-why__item">
              <h3 class="pl-why__title">{{ item.title }}</h3>
              <p class="pl-why__text">{{ item.text }}</p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if audience != blank or for_pets != blank -%}
      <div class="pl-story2__part pl-story2__part--split pl-reveal">
        <div>
          <h2 class="pl-h3">{{ section.settings.audience_heading }}</h2>
          {%- if audience != blank -%}
            <p class="pl-body pl-story2__note">{{ audience }}</p>
          {%- endif -%}
          {%- if for_pets != blank -%}
            <p class="pl-story2__pets">{{ section.settings.pets_label }} <strong>{{ for_pets }}</strong></p>
          {%- endif -%}
        </div>
        {%- if safety != blank -%}
          <div class="pl-safety">
            <h2 class="pl-h3">{{ section.settings.safety_heading }}</h2>
            <p class="pl-body pl-story2__note">{{ safety }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if faq != blank -%}
      <div class="pl-story2__part pl-reveal">
        <h2 class="pl-h2">{{ section.settings.faq_heading }}</h2>
        <div class="pl-qa">
          {%- for row in faq -%}
            <details class="pl-qa__row"{% if forloop.first %} open{% endif %}>
              <summary class="pl-qa__q">
                <span>{{ row.q }}</span>
                <span class="pl-qa__sign" aria-hidden="true"></span>
              </summary>
              <div class="pl-qa__a"><p>{{ row.a }}</p></div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .pl-story2 { background: var(--pl-porcelain); }
  .pl-story2__part { margin-block-start: clamp(38px, 6vw, 74px); }
  .pl-story2__part:first-child { margin-block-start: 0; }
  .pl-story2 .pl-h2 { margin-block-end: clamp(16px, 2.4vw, 26px); }

  /* The problem, stated once and given room. Tinted rather than boxed, so it
     reads as the opening of an argument and not as a callout widget. */
  .pl-story2__problem {
    background: var(--pl-cream);
    border-radius: var(--pl-r-l);
    padding: clamp(22px, 4vw, 44px);
  }
  .pl-story2__problem-text {
    font-family: var(--pl-display);
    font-weight: 600;
    font-size: clamp(1.24rem, 4.6vw, 1.9rem);
    line-height: 1.45;
    color: var(--pl-ink);
    margin: 0;
    max-width: 40ch;
    text-wrap: pretty;
  }

  /* ---- before / after ---------------------------------------------------- */
  .pl-cmp { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .pl-cmp { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  .pl-cmp__card {
    min-width: 0;
    border-radius: var(--pl-r-l);
    padding: clamp(18px, 3vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pl-cmp__card--before { background: var(--pl-white); border: 1px solid var(--pl-line); }
  .pl-cmp__card--after  { background: var(--pl-ink); color: var(--pl-porcelain); }
  .pl-cmp__tag {
    align-self: flex-start;
    font-family: var(--pl-sans);
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .04em;
    padding: 6px 13px;
    border-radius: var(--pl-r-pill);
  }
  .pl-cmp__card--before .pl-cmp__tag { background: var(--pl-sand); color: var(--pl-ink-soft); }
  .pl-cmp__card--after  .pl-cmp__tag { background: var(--pl-clay); color: var(--pl-porcelain); }
  .pl-cmp__img { width: 100%; height: auto; border-radius: var(--pl-r-m); display: block; }
  .pl-cmp__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; }
  .pl-cmp__list li {
    position: relative;
    font-family: var(--pl-sans);
    font-size: .95rem;
    line-height: 1.6;
    padding-inline-start: 26px;
  }
  .pl-cmp__card--before .pl-cmp__list li { color: var(--pl-ink-soft); }
  .pl-cmp__card--after  .pl-cmp__list li { color: var(--pl-porcelain); }
  /* The cross and the tick are drawn, not typed, so they never depend on an
     emoji font and never mirror. Physical borders on purpose: a tick built from
     logical borders turns into a chevron the moment the page is RTL. */
  .pl-cmp__list li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: .42em;
    width: 12px; height: 7px;
  }
  .pl-cmp__card--after .pl-cmp__list li::before {
    border-left: 2px solid var(--pl-clay);
    border-bottom: 2px solid var(--pl-clay);
    transform: rotate(-45deg);
  }
  .pl-cmp__card--before .pl-cmp__list li::before {
    inset-block-start: .55em;
    height: 0;
    border-bottom: 2px solid var(--pl-sand-deep);
  }

  /* ---- steps ------------------------------------------------------------- */
  .pl-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; counter-reset: pl-step; }
  @media (min-width: 640px) { .pl-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  @media (min-width: 1024px) { .pl-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pl-steps__item {
    min-width: 0;
    background: var(--pl-white);
    border: 1px solid var(--pl-line);
    border-radius: var(--pl-r-m);
    padding: clamp(16px, 2.6vw, 24px);
  }
  .pl-steps__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px; height: 34px;
    border-radius: var(--pl-r-pill);
    background: var(--pl-cream);
    color: var(--pl-clay);
    font-family: var(--pl-display);
    font-weight: 700;
    font-size: 1rem;
    margin-block-end: 12px;
  }
  .pl-steps__title { font-family: var(--pl-sans); font-size: 1rem; font-weight: 700; color: var(--pl-ink); margin: 0; }
  .pl-steps__text { font-family: var(--pl-sans); font-size: .92rem; line-height: 1.65; color: var(--pl-ink-soft); margin: 7px 0 0; }

  /* ---- why it works ------------------------------------------------------ */
  .pl-why { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 760px) { .pl-why { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; } }
  .pl-why__item {
    min-width: 0;
    padding-inline-start: 18px;
    border-inline-start: 2px solid var(--pl-sand);
  }
  .pl-why__title { font-family: var(--pl-sans); font-size: 1rem; font-weight: 700; color: var(--pl-ink); margin: 0; }
  .pl-why__text { font-family: var(--pl-sans); font-size: .94rem; line-height: 1.7; color: var(--pl-ink-soft); margin: 6px 0 0; }

  /* ---- audience and safety ----------------------------------------------- */
  .pl-story2__part--split { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .pl-story2__part--split { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; } }
  .pl-story2__part--split > * { min-width: 0; }
  .pl-story2__note { margin-block-start: 10px; max-width: 52ch; }
  .pl-story2__pets { font-family: var(--pl-sans); font-size: .9rem; color: var(--pl-ink-soft); margin: 12px 0 0; }
  .pl-safety {
    background: var(--pl-cream);
    border-radius: var(--pl-r-m);
    padding: clamp(16px, 2.6vw, 24px);
  }

  /* ---- product FAQ ------------------------------------------------------- */
  .pl-qa { border-block-start: 1px solid var(--pl-line); }
  .pl-qa__row { border-block-end: 1px solid var(--pl-line); }
  .pl-qa__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    /* 56px of row height, so the whole question is a thumb target. */
    padding-block: 18px;
    font-family: var(--pl-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--pl-ink);
    cursor: pointer;
    list-style: none;
  }
  .pl-qa__q::-webkit-details-marker { display: none; }
  .pl-qa__q:focus-visible { outline: 2px solid var(--pl-clay); outline-offset: 2px; }
  /* A plus that becomes a minus. Two bars, one rotated, so there is no icon
     font to load and nothing to mirror under RTL. */
  .pl-qa__sign { position: relative; flex: 0 0 auto; width: 14px; height: 14px; margin-block-start: 4px; }
  .pl-qa__sign::before, .pl-qa__sign::after {
    content: "";
    position: absolute;
    inset-block-start: 6px;
    inset-inline-start: 0;
    width: 14px; height: 2px;
    background: var(--pl-clay);
    transition: transform .25s var(--pl-ease);
  }
  .pl-qa__sign::after { transform: rotate(90deg); }
  .pl-qa__row[open] .pl-qa__sign::after { transform: rotate(0deg); }
  .pl-qa__a { padding-block-end: 20px; }
  .pl-qa__a p {
    font-family: var(--pl-sans);
    font-size: .95rem;
    line-height: 1.75;
    color: var(--pl-ink-soft);
    margin: 0;
    max-width: 62ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TinyBloom · Product story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "problem_eyebrow", "label": "Problem eyebrow", "default": "הבעיה" },
    { "type": "text", "id": "compare_heading", "label": "Before/after heading", "default": "לפני ואחרי" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "לפני" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "אחרי" },
    { "type": "text", "id": "steps_heading", "label": "Steps heading", "default": "איך משתמשים" },
    { "type": "text", "id": "why_heading", "label": "Why heading", "default": "למה זה עובד" },
    { "type": "textarea", "id": "why_body", "label": "Why intro" },
    { "type": "text", "id": "audience_heading", "label": "Audience heading", "default": "למי זה מתאים" },
    { "type": "text", "id": "pets_label", "label": "Pets label", "default": "מתאים ל:" },
    { "type": "text", "id": "safety_heading", "label": "Safety heading", "default": "שימוש ובטיחות" },
    { "type": "text", "id": "faq_heading", "label": "Product FAQ heading", "default": "שאלות על המוצר" }
  ],
  "presets": [{ "name": "TinyBloom · Product story" }]
}
{% endschema %}
