{%- comment -%}
  Hero with the photo and the words kept apart. Nothing is set over the image,
  so the headline stays legible on any photo and at any phone width.
{%- endcomment -%}

{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: img
-%}

<section class="pl-heroP">
  <div class="pl-wrap pl-heroP__grid">
    <div class="pl-heroP__media">
      {%- if img != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ img_m | image_url: width: 700 }} 700w, {{ img_m | image_url: width: 1100 }} 1100w"
            sizes="92vw"
          >
          <img
            src="{{ img | image_url: width: 1400 }}"
            srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
            sizes="(max-width: 899px) 92vw, 50vw"
            width="{{ img.width }}"
            height="{{ img.height }}"
            alt="{{ img.alt | default: section.settings.image_alt | escape }}"
            fetchpriority="high"
            decoding="async"
          >
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pl-heroP__ph' }}
      {%- endif -%}
    </div>

    <div class="pl-heroP__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="pl-h1">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.show_rating -%}
        <div class="pl-heroP__rating">
          {% render 'pl-stars', value: section.settings.rating_value, size: 16, label: 'דירוג ממוצע' %}
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}

      <div class="pl-heroP__actions">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="pl-btn pl-btn--solid">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link | default: '/collections/all' }}" class="pl-btn pl-btn--ghost">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.chip_1 != blank or section.settings.chip_2 != blank or section.settings.chip_3 != blank -%}
    <div class="pl-heroP__trust">
      <ul class="pl-wrap pl-heroP__chips" role="list">
        {%- if section.settings.chip_1 != blank %}<li>{{ section.settings.chip_1 }}</li>{% endif -%}
        {%- if section.settings.chip_2 != blank %}<li>{{ section.settings.chip_2 }}</li>{% endif -%}
        {%- if section.settings.chip_3 != blank %}<li>{{ section.settings.chip_3 }}</li>{% endif -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .pl-heroP { background: var(--pl-porcelain); padding-block-start: clamp(16px, 3vw, 34px); }
  .pl-heroP__grid { display: grid; gap: clamp(22px, 4vw, 52px); align-items: center; }
  @media (min-width: 900px) { .pl-heroP__grid { grid-template-columns: 1fr 1fr; } }

  /* The hero photograph is landscape, so the crop stays wide at every width
     instead of squeezing the two animals out of frame on a phone. */
  .pl-heroP__media {
    border-radius: var(--pl-r-l);
    overflow: hidden;
    background: var(--pl-cream);
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 600px) { .pl-heroP__media { aspect-ratio: 3 / 2; } }
  @media (min-width: 900px) { .pl-heroP__media { aspect-ratio: 4 / 3; } }
  .pl-heroP__media img, .pl-heroP__ph { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pl-heroP__copy { display: block; }
  .pl-heroP__rating {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-block-start: 18px;
    font-family: var(--pl-sans);
    font-size: .88rem;
    font-weight: 600;
    color: var(--pl-ink-soft);
  }
  .pl-heroP__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-start: 26px;
  }

  .pl-heroP__trust { margin-block-start: clamp(28px, 4vw, 48px); border-block: 1px solid var(--pl-line); background: var(--pl-cream); }
  .pl-heroP__chips {
    list-style: none;
    margin: 0;
    display: grid;
    gap: 10px;
    padding-block: 16px;
  }
  @media (min-width: 700px) { .pl-heroP__chips { grid-template-columns: repeat(3, 1fr); text-align: center; } }
  .pl-heroP__chips li {
    position: relative;
    font-family: var(--pl-sans);
    font-size: .88rem;
    font-weight: 600;
    color: var(--pl-ink-soft);
    padding-inline-start: 24px;
  }
  @media (min-width: 700px) { .pl-heroP__chips li { padding-inline: 24px; } }
  .pl-heroP__chips li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: .38em;
    width: 12px;
    height: 7px;
    border-inline-start: 2.5px solid var(--pl-clay);
    border-block-end: 2.5px solid var(--pl-clay);
    transform: rotate(-45deg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "כדי שהם יישארו על השטיח, לא השיער שלהם" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating strip", "default": true },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.8" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8 מתוך 5 · 82 ביקורות" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "לכל המוצרים" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "chip_1", "label": "Chip 1" },
    { "type": "text", "id": "chip_2", "label": "Chip 2" },
    { "type": "text", "id": "chip_3", "label": "Chip 3" }
  ],
  "presets": [{ "name": "PLUMA · Hero" }]
}
{% endschema %}
