{%- liquid
  assign coll = collections[section.settings.collection]
-%}
<section class="pl-bundle pl-section">
  <div class="pl-wrap">
    <div class="pl-bundle__panel pl-reveal">
      <div class="pl-bundle__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow pl-bundle__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="pl-h2 pl-bundle__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="pl-lede pl-bundle__lede">{{ section.settings.body }}</p>{%- endif -%}

        <ul class="pl-bundle__list">
          {%- for product in coll.products limit: 4 -%}
            <li>{{ product.title }}</li>
          {%- endfor -%}
        </ul>

        <div class="pl-bundle__actions">
          <a class="pl-btn pl-btn--light" href="{{ section.settings.cta_link | default: coll.url | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
          <span class="pl-bundle__note">{{ section.settings.note }}</span>
        </div>
      </div>

      <div class="pl-bundle__media">
        {%- for product in coll.products limit: 3 -%}
          {%- if product.featured_image != blank -%}
            <img src="{{ product.featured_image | image_url: width: 620 }}"
                 width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
                 alt="{{ product.featured_image.alt | default: product.title | escape }}"
                 loading="lazy" decoding="async">
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .pl-bundle { background: var(--pl-porcelain); }
  .pl-bundle__panel {
    background: var(--pl-ink);
    color: var(--pl-porcelain);
    border-radius: var(--pl-r-l);
    padding: clamp(30px, 4.4vw, 66px);
    display: grid;
    gap: clamp(30px, 4vw, 56px);
    grid-template-columns: 1fr;
    align-items: center;
    overflow: hidden;
  }
  @media (min-width: 900px) { .pl-bundle__panel { grid-template-columns: 1fr .85fr; } }
  .pl-bundle__eyebrow { color: var(--pl-sand); }
  .pl-bundle__heading { color: var(--pl-porcelain); }
  .pl-bundle__lede { color: rgba(251, 249, 245, .74); }
  .pl-bundle__list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 11px;
  }
  .pl-bundle__list li {
    position: relative;
    font-family: var(--pl-sans);
    font-size: .95rem;
    color: rgba(251, 249, 245, .9);
    padding-inline-start: 24px;
  }
  .pl-bundle__list li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: .5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pl-clay);
  }
  .pl-bundle__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-block-start: 32px;
  }
  .pl-bundle__note { font-family: var(--pl-sans); font-size: .82rem; color: rgba(251, 249, 245, .55); }
  .pl-bundle__media {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .pl-bundle__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--pl-r-m);
    background: var(--pl-cream);
    display: block;
  }
  .pl-bundle__media img:first-child { grid-column: span 2; aspect-ratio: 16 / 10; }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Bundle",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Bundle collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "הכי משתלם" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ערכת הפרווה המלאה" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "שלושת הכלים שעושים את כל העבודה: סירוק, איסוף ותחזוקה. מי שקונה את השלושה מפסיק לקנות רולרים דביקים לתמיד." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "לראות מה בפנים" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note", "default": "מחירי הערכה יפורסמו עם ההשקה" }
  ],
  "presets": [{ "name": "PLUMA · Bundle" }]
}
{% endschema %}
