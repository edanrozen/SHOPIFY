{%- comment -%}
  Brand story. One lead photograph next to the words, then a row of three
  supporting frames underneath. Nothing is set on top of an image.
{%- endcomment -%}

<section class="pl-story pl-section">
  <div class="pl-wrap">
    <div class="pl-story__lead">
      <div class="pl-story__media pl-reveal">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
            sizes="(max-width: 899px) 92vw, 46vw"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.image_alt | escape }}"
            loading="lazy" decoding="async"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'pl-story__ph' }}
        {%- endif -%}
      </div>

      <div class="pl-story__copy pl-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="pl-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <div class="pl-story__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank or section.settings.stat_3_value != blank -%}
          <ul class="pl-story__stats" role="list">
            {%- if section.settings.stat_1_value != blank -%}
              <li><strong>{{ section.settings.stat_1_value }}</strong><span>{{ section.settings.stat_1_label }}</span></li>
            {%- endif -%}
            {%- if section.settings.stat_2_value != blank -%}
              <li><strong>{{ section.settings.stat_2_value }}</strong><span>{{ section.settings.stat_2_label }}</span></li>
            {%- endif -%}
            {%- if section.settings.stat_3_value != blank -%}
              <li><strong>{{ section.settings.stat_3_value }}</strong><span>{{ section.settings.stat_3_label }}</span></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a class="pl-btn pl-btn--solid pl-story__cta" href="{{ section.settings.cta_link | default: '/pages/about' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- assign has_row = false -%}
    {%- if section.settings.image_1 != blank or section.settings.image_2 != blank or section.settings.image_3 != blank -%}
      {%- assign has_row = true -%}
    {%- endif -%}

    {%- if has_row -%}
      <ul class="pl-story__row" role="list">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign frame = section.settings.image_1
                assign cap = section.settings.caption_1
              when 2
                assign frame = section.settings.image_2
                assign cap = section.settings.caption_2
              else
                assign frame = section.settings.image_3
                assign cap = section.settings.caption_3
            endcase
          -%}
          {%- if frame != blank -%}
            <li class="pl-reveal" style="transition-delay: {{ forloop.index0 | times: 80 }}ms;">
              <figure class="pl-story__frame">
                <img
                  src="{{ frame | image_url: width: 900 }}"
                  srcset="{{ frame | image_url: width: 500 }} 500w, {{ frame | image_url: width: 900 }} 900w"
                  sizes="(max-width: 759px) 78vw, 30vw"
                  width="{{ frame.width }}" height="{{ frame.height }}"
                  alt="{{ frame.alt | default: cap | escape }}"
                  loading="lazy" decoding="async"
                >
                {%- if cap != blank -%}<figcaption>{{ cap }}</figcaption>{%- endif -%}
              </figure>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pl-story { background: var(--pl-cream); }
  .pl-story__lead { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; }
  @media (min-width: 900px) { .pl-story__lead { grid-template-columns: 1fr 1fr; } }

  .pl-story__media {
    border-radius: var(--pl-r-l);
    overflow: hidden;
    background: var(--pl-porcelain);
    aspect-ratio: 4 / 3;
  }
  .pl-story__media img, .pl-story__ph { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pl-story__body {
    font-family: var(--pl-sans);
    font-size: clamp(1rem, 3.8vw, 1.08rem);
    line-height: 1.78;
    color: var(--pl-ink-soft);
    margin-block-start: 14px;
    max-width: 52ch;
  }
  .pl-story__body p { margin: 0 0 14px; }
  .pl-story__body p:last-child { margin-block-end: 0; }

  .pl-story__stats {
    list-style: none;
    margin: clamp(22px, 3vw, 32px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    border-block-start: 1px solid var(--pl-sand-deep);
    padding-block-start: 20px;
  }
  .pl-story__stats li { display: grid; gap: 3px; }
  .pl-story__stats strong {
    font-family: var(--pl-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 5vw, 1.7rem);
    color: var(--pl-ink);
    line-height: 1.1;
  }
  .pl-story__stats span { font-family: var(--pl-sans); font-size: .78rem; line-height: 1.4; color: var(--pl-taupe); }
  .pl-story__cta { margin-block-start: clamp(24px, 3vw, 32px); }

  .pl-story__row {
    list-style: none;
    margin: clamp(30px, 4.5vw, 60px) calc(var(--pl-gutter) * -1) 0;
    padding: 0 var(--pl-gutter);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 74vw;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .pl-story__row::-webkit-scrollbar { display: none; }
  .pl-story__row > li { scroll-snap-align: start; }
  @media (min-width: 760px) {
    .pl-story__row {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(14px, 2vw, 22px);
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  .pl-story__frame { margin: 0; }
  .pl-story__frame img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    border-radius: var(--pl-r-m);
    background: var(--pl-porcelain);
  }
  .pl-story__frame figcaption {
    font-family: var(--pl-sans);
    font-size: .82rem;
    line-height: 1.6;
    color: var(--pl-taupe);
    margin-block-start: 10px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "מי אנחנו" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "מותג אחד, בית אחד, אותה מטרה" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Lead image" },
    { "type": "text", "id": "image_alt", "label": "Lead image alt text" },
    { "type": "header", "content": "Numbers" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Three frames" },
    { "type": "image_picker", "id": "image_1", "label": "Frame 1" },
    { "type": "text", "id": "caption_1", "label": "Caption 1" },
    { "type": "image_picker", "id": "image_2", "label": "Frame 2" },
    { "type": "text", "id": "caption_2", "label": "Caption 2" },
    { "type": "image_picker", "id": "image_3", "label": "Frame 3" },
    { "type": "text", "id": "caption_3", "label": "Caption 3" }
  ],
  "presets": [{ "name": "PLUMA · Story" }]
}
{% endschema %}
