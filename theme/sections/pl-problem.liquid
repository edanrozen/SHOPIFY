<section class="pl-problem pl-section">
  <div class="pl-wrap">
    <div class="pl-problem__head pl-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="pl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="pl-problem__stats">
      {%- for block in section.blocks -%}
        <article class="pl-stat pl-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 90 }}ms;">
          <p class="pl-stat__value">{{ block.settings.value }}</p>
          <h3 class="pl-h3 pl-stat__title">{{ block.settings.title }}</h3>
          <p class="pl-body pl-stat__text">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pl-problem { background: var(--pl-cream); }
  .pl-problem__head { max-width: 46rem; }
  .pl-problem__stats {
    margin-block-start: clamp(38px, 5vw, 62px);
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .pl-problem__stats { grid-template-columns: repeat(3, 1fr); } }
  .pl-stat {
    background: var(--pl-porcelain);
    border-radius: var(--pl-r-l);
    padding: clamp(26px, 3.4vw, 40px);
    border: 1px solid var(--pl-line);
    transition: transform .5s var(--pl-ease), box-shadow .5s var(--pl-ease), opacity .85s var(--pl-ease);
  }
  /* Gated: on touch, :hover sticks to the last thing tapped. */
  @media (hover: hover) and (pointer: fine) {
    .pl-stat:hover { transform: translateY(-4px); box-shadow: var(--pl-sh-m); }
  }
  .pl-stat__value {
    font-family: var(--pl-display);
    font-size: clamp(2.4rem, 4.6vw, 3.4rem);
    line-height: 1;
    color: var(--pl-clay);
    margin: 0 0 16px;
  }
  .pl-stat__title { margin-block-end: 10px; }
  .pl-stat__text { font-size: .95rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Problem",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "למה בכלל" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "כלב או חתול בבית = שיער בכל מקום" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "רולר דביק נגמר. שואב לא מגיע לסיבים. הפתרון הוא לא לנקות יותר, אלא להוריד את הפרווה מהחיה לפני שהיא מתפזרת." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "‎5 דק׳" },
        { "type": "text", "id": "title", "label": "Title", "default": "סירוק יומי" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "חמש דקות סירוק ביום מורידות עד 70% מהשיער הנושר לפני שהוא מגיע לרהיטים." }
      ]
    }
  ],
  "presets": [{
    "name": "PLUMA · Problem",
    "blocks": [
      { "type": "stat", "settings": { "value": "‎5 דק׳", "title": "סירוק יומי", "text": "חמש דקות סירוק ביום מורידות את רוב השיער הנושר לפני שהוא מגיע לספה." } },
      { "type": "stat", "settings": { "value": "‎0", "title": "מילויים", "text": "גליל נחושת שעובד מכנית, בלי דבק, בלי חשמל, בלי הוצאה חוזרת כל חודש." } },
      { "type": "stat", "settings": { "value": "‎2×", "title": "פחות ניקיון", "text": "לקוחות מדווחים שהם שואבים חצי מהפעמים אחרי שהכניסו שגרת טיפוח קבועה." } }
    ]
  }]
}
{% endschema %}
