<section class="pl-ritual pl-section" id="pl-ritual" style="scroll-margin-block-start: 96px;">
  <div class="pl-wrap pl-ritual__grid">
    <div class="pl-ritual__intro pl-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="pl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="pl-lede">{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="pl-btn pl-btn--solid pl-ritual__cta" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>

    <ol class="pl-ritual__steps">
      {%- for block in section.blocks -%}
        <li class="pl-step pl-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 110 }}ms;">
          <span class="pl-step__num">{{ forloop.index }}</span>
          <div>
            <h3 class="pl-h3">{{ block.settings.title }}</h3>
            <p class="pl-body pl-step__text">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .pl-ritual { background: var(--pl-porcelain); }
  .pl-ritual__grid {
    display: grid;
    gap: clamp(36px, 5vw, 76px);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 940px) { .pl-ritual__grid { grid-template-columns: .9fr 1.1fr; } }
  .pl-ritual__cta { margin-block-start: 30px; }
  .pl-ritual__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .pl-step {
    display: flex;
    gap: clamp(16px, 2.2vw, 28px);
    padding-block: clamp(24px, 3vw, 34px);
    border-block-start: 1px solid var(--pl-line);
  }
  .pl-step:last-child { border-block-end: 1px solid var(--pl-line); }
  .pl-step__num {
    flex: 0 0 auto;
    font-family: var(--pl-display);
    font-size: 1.15rem;
    color: var(--pl-clay);
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--pl-sand-deep);
    border-radius: 50%;
  }
  .pl-step__text { margin-block-start: 9px; font-size: .96rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "PLUMA · Ritual",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "שגרה של שלוש דקות" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "איך שומרים על בית בלי פרווה" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "לא צריך יותר זמן, צריך סדר פעולות. זו השגרה שאנחנו ממליצים עליה, ואפשר לעשות אותה מול הטלוויזיה." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "להרכיב ערכה" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "מסרקים" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "תיאור השלב." }
      ]
    }
  ],
  "presets": [{
    "name": "PLUMA · Ritual",
    "blocks": [
      { "type": "step", "settings": { "title": "מסרקים את הפרווה", "text": "המסרק מפריד את שכבת הפלומה ומוציא את השיער שכבר נשר, לפני שהוא מספיק להתפזר. שתי דקות מול הטלוויזיה." } },
      { "type": "step", "settings": { "title": "אוספים מהרהיטים", "text": "מעבר אחד של גליל הנחושת על הספה, על השמיכה ועל מושב הרכב. תמיד בכיוון אחד, כך הסיבים משחררים את השיער." } },
      { "type": "step", "settings": { "title": "נותנים להם מקום משלהם", "text": "מיטה או פינת מנוחה קבועה מרכזת את רוב השיער במקום אחד, ומצילה את הספה מלהיות ברירת המחדל." } }
    ]
  }]
}
{% endschema %}
